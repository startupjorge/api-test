- content_for :title, "Natural Language Query · API Queries & How-To · Gumshoe"

.page-header
  %p.text-muted= link_to "← API Queries & How-To", api_queries_path
  %h1 💬 Natural Language Query
  %p.text-muted Ask a question in plain English — the app detects the intent and runs the matching API call automatically.

.panel
  .card-header
    %h3 What it does
  .card-body
    %p Type a question in plain English on the Explore page. The app parses your query to detect what you're asking — rank trends, not mentioned, or listing reports — then calls the appropriate Gumshoe API endpoints and displays the results.
    %p No need to know which endpoint to call or how to construct the request. The app handles it.

.panel{style: "margin-top: 1.5rem;"}
  .card-header
    %h3 Supported query types
  .card-body
    %table{style: "width: 100%; border-collapse: collapse; font-size: 0.875rem;"}
      %thead
        %tr
          %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600;"} What you type
          %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600;"} What it runs
      %tbody
        %tr
          %td{style: "padding: 0.5rem 0.75rem; border-bottom: 1px solid #f1f5f9;"}
            %code Show rank trends for report 22110
          %td{style: "padding: 0.5rem 0.75rem; border-bottom: 1px solid #f1f5f9;"} #{link_to "% Results Ranked #1", api_query_rank_trends_path} — fetches all runs and charts brand rank over time
        %tr
          %td{style: "padding: 0.5rem 0.75rem; border-bottom: 1px solid #f1f5f9;"}
            %code Not mentioned for brand shipiumcom in report 22110 run 1
          %td{style: "padding: 0.5rem 0.75rem; border-bottom: 1px solid #f1f5f9;"} #{link_to "Not Mentioned", api_query_not_mentioned_path} — lists answers where the brand never appeared
        %tr
          %td{style: "padding: 0.5rem 0.75rem;"}
            %code List my reports
          %td{style: "padding: 0.5rem 0.75rem;"} Calls <code>GET /reports</code> and returns all your reports

.panel{style: "margin-top: 1.5rem;"}
  .card-header
    %h3 How to run it
  .card-body
    %ol{style: "font-size: 0.875rem; color: #374151; padding-left: 1.25rem; line-height: 2;"}
      %li Go to #{link_to "Explore Gumshoe API", explore_internal_path}
      %li Type your question in plain English
      %li Click Run — the app detects the intent and shows results

.panel{style: "margin-top: 1.5rem;"}
  .card-header
    %h3 API endpoints used under the hood
  .card-body
    %code{style: "font-size: 0.8rem; background: #f1f5f9; padding: 0.3rem 0.6rem; border-radius: 4px; display: inline-block; margin-bottom: 0.5rem;"} GET /reports
    %br
    %code{style: "font-size: 0.8rem; background: #f1f5f9; padding: 0.3rem 0.6rem; border-radius: 4px; display: inline-block; margin-bottom: 0.5rem;"} GET /reports/:id/runs
    %br
    %code{style: "font-size: 0.8rem; background: #f1f5f9; padding: 0.3rem 0.6rem; border-radius: 4px; display: inline-block;"} GET /reports/:id/runs/:ordinal/raw
