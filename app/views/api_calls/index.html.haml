- content_for :title, "API Queries & How-To · Gumshoe"

.page-header
  %h1 API Queries & How-To
  %p.text-muted The queries available in the Gumshoe API — what they do, how to run them, and how to use them directly

.panel{style: "margin-bottom: 1.5rem; background: #f8fafc; border: 1px solid #e2e8f0;"}
  .card-body{style: "display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;"}
    %div
      %p{style: "margin: 0; font-weight: 600; color: #1e293b;"} Gumshoe OpenAPI Reference
      %p{style: "margin: 0.25rem 0 0; font-size: 0.875rem; color: #64748b;"} Full API spec — all endpoints, parameters, and response schemas
    = link_to "View API Docs →", "https://app.gumshoe.ai/openapi", target: "_blank", rel: "noopener", class: "btn btn-primary btn-sm"

- recent_runs = (@query_history || []).select { |h| %w[trends not_mentioned].include?(h["action"]) }
- if recent_runs.any?
  .explore-recent{style: "margin-bottom: 1.5rem;"}
    %p.explore-recent-label Recent Runs:
    %ul.explore-recent-list
      - recent_runs.first(10).each do |h|
        - label = h["action"] == "trends" ? "% Results Ranked #1" : "% of Conversations Not Mentioned"
        - detail = [h["report_id"], h["brand_key"]].compact.join(" · ")
        %li
          = link_to label, explore_internal_path(query: h["query"]), class: "recent-query-link"
          - if detail.present?
            %span.recent-query-meta= detail

.feature-grid

  .feature-card
    .feature-card-icon 📈
    %h3 % Results Ranked #1
    %p.text-muted What it does
    %p Measures how often each brand appears as the #1 AI answer across every run of a report. Tracks brand visibility momentum over time.
    %p.text-muted{style: "font-size: 0.825rem; margin-top: 0.75rem;"} API endpoint used
    %code{style: "font-size: 0.8rem; background: #f1f5f9; padding: 0.3rem 0.6rem; border-radius: 4px; display: block; margin-bottom: 0.75rem;"} GET /reports/:id/runs/:ordinal/raw
    %p.text-muted{style: "font-size: 0.825rem;"} How to run it
    %p{style: "font-size: 0.875rem;"} Go to My Reports → click a report → View Chart. Or call the raw endpoint and count mentions where rank == 1, divided by total answers.
    .feature-card-actions
      = link_to "Details →", api_query_rank_trends_path, class: "btn btn-primary btn-sm"

  .feature-card
    .feature-card-icon 🔍
    %h3 Not Mentioned
    %p.text-muted What it does
    %p Finds every AI conversation where a specific brand was completely absent from the answer. Surfaces competitive gaps and blind spots.
    %p.text-muted{style: "font-size: 0.825rem; margin-top: 0.75rem;"} API endpoint used
    %code{style: "font-size: 0.8rem; background: #f1f5f9; padding: 0.3rem 0.6rem; border-radius: 4px; display: block; margin-bottom: 0.75rem;"} GET /reports/:id/runs/:ordinal/raw
    %p.text-muted{style: "font-size: 0.825rem;"} How to run it
    %p{style: "font-size: 0.875rem;"} Go to My Reports → click a report → View Results. Or call the raw endpoint and filter answers where the brand key does not appear in any mention.
    .feature-card-actions
      = link_to "Details →", api_query_not_mentioned_path, class: "btn btn-primary btn-sm"


- if @query_history.any?
  .panel{style: "margin-top: 2rem; margin-bottom: 2rem;"}
    .card-header
      %h3 Queries run this session
    .card-body
      %table{style: "width: 100%; border-collapse: collapse; font-size: 0.875rem;"}
        %thead
          %tr
            %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600;"} Query
            %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600;"} Type
            %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600;"} Report
            %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600;"} Ran at
            %th{style: "padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0;"}
        %tbody
          - @query_history.each do |h|
            %tr
              %td{style: "padding: 0.5rem 0.75rem; border-bottom: 1px solid #f1f5f9; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"}= h["query"]
              %td{style: "padding: 0.5rem 0.75rem; border-bottom: 1px solid #f1f5f9; color: #374151;"}= h["action"].to_s.gsub("_", " ").capitalize
              %td{style: "padding: 0.5rem 0.75rem; border-bottom: 1px solid #f1f5f9; color: #374151;"}
                - if h["report_id"]
                  %code{style: "background: #f1f5f9; padding: 0.1rem 0.4rem; border-radius: 3px;"}= h["report_id"]
              %td{style: "padding: 0.5rem 0.75rem; border-bottom: 1px solid #f1f5f9; color: #6b7280; white-space: nowrap;"}
                - if h["ran_at"]
                  = Time.parse(h["ran_at"]).strftime("%-m/%-d %H:%M") rescue h["ran_at"]
              %td{style: "padding: 0.5rem 0.75rem; border-bottom: 1px solid #f1f5f9;"}
                = link_to "Re-run →", explore_internal_path(query: h["query"]), class: "btn btn-primary btn-sm"

.panel{style: "margin-top: 2rem;"}
  .card-header
    %h3 Running queries directly via the API
  .card-body
    %p{style: "margin-bottom: 1rem; color: #374151;"} Every query in this app is powered by the Gumshoe REST API. You can run them directly using curl or any HTTP client.
    %p.text-muted{style: "font-size: 0.875rem; font-weight: 600; margin-bottom: 0.375rem;"} Authentication
    %code{style: "font-size: 0.8rem; background: #f1f5f9; padding: 0.4rem 0.75rem; border-radius: 4px; display: block; margin-bottom: 1rem;"} Authorization: Bearer YOUR_API_KEY
    %p.text-muted{style: "font-size: 0.875rem; font-weight: 600; margin-bottom: 0.375rem;"} Example — fetch raw run data
    %code{style: "font-size: 0.8rem; background: #f1f5f9; padding: 0.4rem 0.75rem; border-radius: 4px; display: block; white-space: pre-wrap; margin-bottom: 1rem;"} curl -H "Authorization: Bearer YOUR_API_KEY" https://api.gumshoe.ai/reports/22110/runs/1/raw
    %p.text-muted{style: "font-size: 0.875rem; font-weight: 600; margin-bottom: 0.375rem;"} Example — list reports
    %code{style: "font-size: 0.8rem; background: #f1f5f9; padding: 0.4rem 0.75rem; border-radius: 4px; display: block; white-space: pre-wrap;"} curl -H "Authorization: Bearer YOUR_API_KEY" https://api.gumshoe.ai/reports
