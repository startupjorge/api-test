- content_for :title, "Add Query · Gumshoe"

.page-header
  %h1 Add a Custom Query
  %p.text-muted Pick a report, fetch a live run, and click the field you want to chart.

.query-builder

  / ── Step 1: Pick a report ───────────────────────────────────
  .qb-step
    .qb-step-header
      .qb-step-num 1
      %strong Pick a report
    .qb-step-body
      .qb-report-row
        %select#qb-report-select.form-input{style: "max-width: 360px;"}
          %option{value: ""} Loading reports…
        %button#qb-fetch-btn.btn.btn-primary{onclick: "qbFetchSample()", disabled: true} Fetch Fields →
      %p#qb-fetch-status.text-muted{style: "font-size: 0.82rem; margin-top: 0.5rem; display: none;"}

  / ── Step 2: Pick a field ────────────────────────────────────
  #qb-step2{style: "display: none;"}
    .qb-step{style: "margin-top: 1.5rem;"}
      .qb-step-header
        .qb-step-num 2
        %strong Pick a field to chart
      .qb-step-body
        %p.text-muted{style: "font-size: 0.85rem; margin-bottom: 1rem;"}
          These are all the numeric score fields found in this report's latest run.
          %strong Click one to use it.
        #qb-field-list{style: "display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.75rem;"}

        %details{style: "margin-top: 1.25rem;"}
          %summary{style: "cursor: pointer; font-size: 0.82rem; color: #64748b; user-select: none; display: inline-flex; align-items: center; gap: 0.4rem;"}
            🔍 View raw JSON response
          #qb-json-explorer{style: "margin-top: 0.75rem; background: #0f172a; border-radius: 8px; padding: 1.25rem 1.5rem; overflow: auto; max-height: 480px; font-family: monospace; font-size: 0.78rem; line-height: 1.8; white-space: pre;"}

  / ── Step 3: Configure & save ────────────────────────────────
  #qb-step3{style: "display: none;"}
    .qb-step{style: "margin-top: 1.5rem;"}
      .qb-step-header
        .qb-step-num 3
        %strong Name it and save
      .qb-step-body
        .qb-selected-field{style: "background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; padding: 0.6rem 1rem; margin-bottom: 1.25rem; font-size: 0.875rem; color: #166534; display: flex; align-items: center; gap: 0.75rem;"}
          %span ✓ Selected:
          %strong#qb-selected-path —
          %span.text-muted#qb-selected-value{style: "font-family: monospace; font-size: 0.8rem;"}

        = form_with url: custom_queries_path, method: :post, local: true do |f|
          %input{type: "hidden", name: "custom_query[value_path]", id: "qb-value-path-input", value: ""}

          .two-col{style: "display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;"}
            .form-group
              %label{style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"} Query Name
              %input#qb-name.form-input{type: "text", name: "custom_query[name]", placeholder: "e.g. Navigation Score"}
            .form-group
              %label{style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"} Description
              %input#qb-description.form-input{type: "text", name: "custom_query[description]", placeholder: "What does this measure?"}

          .two-col{style: "display: grid; grid-template-columns: 80px 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;"}
            .form-group
              %label{style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"} Icon
              %input#qb-icon.form-input{type: "text", name: "custom_query[icon]", value: "📊", style: "font-size: 1.2rem; text-align: center;"}
            .form-group
              %label{style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"} Y-Axis Label
              %input#qb-y-axis.form-input{type: "text", name: "custom_query[y_axis_label]", value: "Score"}
            .form-group
              %label{style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"} Active
              %label{style: "display: flex; align-items: center; gap: 0.5rem; margin-top: 0.6rem; cursor: pointer;"}
                %input{type: "checkbox", name: "custom_query[active]", value: "1", checked: true}
                Show on report pages

          .btn-group
            %button.btn.btn-primary{type: "submit"} Save Query
            = link_to "Cancel", custom_queries_path, class: "btn btn-secondary"

:javascript
  // Keys to skip — IDs, metadata, not chartable
  var SKIP_KEYS = new Set(['id','ordinal','rank','order','count','total','page','limit','offset','status','position']);
  var SKIP_SUFFIXES = ['Id','Ids','Count','Total','Ordinal','Order','Rank','Page','Limit','Offset'];

  function isSkippable(key) {
    if (SKIP_KEYS.has(key)) return true;
    for (var i = 0; i < SKIP_SUFFIXES.length; i++) {
      if (key.endsWith(SKIP_SUFFIXES[i])) return true;
    }
    return false;
  }

  // ── Load reports on page boot ────────────────────────────────
  (function() {
    fetch('/custom_queries/api_reports')
      .then(function(r) { return r.json(); })
      .then(function(reports) {
        var sel = document.getElementById('qb-report-select');
        sel.innerHTML = '<option value="">— Select a report —</option>';
        (reports || []).forEach(function(r) {
          var brand = (r.brand || {});
          var label = brand.name || r.title || r.id;
          var opt = document.createElement('option');
          opt.value = r.id;
          opt.textContent = label;
          sel.appendChild(opt);
        });
        document.getElementById('qb-fetch-btn').disabled = false;
      })
      .catch(function() {
        document.getElementById('qb-report-select').innerHTML =
          '<option value="">Error loading reports — check your API key</option>';
      });
  })();

  // ── Fetch sample run ─────────────────────────────────────────
  function qbFetchSample() {
    var reportId = document.getElementById('qb-report-select').value;
    if (!reportId) { alert('Please select a report first.'); return; }
    var status = document.getElementById('qb-fetch-status');
    var btn    = document.getElementById('qb-fetch-btn');
    status.style.display = 'block';
    status.textContent   = 'Fetching latest run…';
    btn.disabled = true;

    fetch('/custom_queries/api_sample_run?report_id=' + encodeURIComponent(reportId))
      .then(function(r) { return r.json(); })
      .then(function(resp) {
        btn.disabled = false;
        if (resp.error) { status.textContent = 'Error: ' + resp.error; return; }
        status.textContent = 'Run #' + resp.ordinal + ' loaded — pick a field below.';
        var fields = [];
        extractFields(resp.data, '', fields);
        renderFieldList(fields);
        document.getElementById('qb-json-explorer').textContent = JSON.stringify(resp.data, null, 2);
        document.getElementById('qb-step2').style.display = 'block';
        document.getElementById('qb-step2').scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
      .catch(function(e) {
        btn.disabled = false;
        status.textContent = 'Error: ' + e.message;
      });
  }

  // ── Extract numeric fields recursively ───────────────────────
  function extractFields(obj, path, results) {
    if (obj === null || typeof obj !== 'object') return;
    if (Array.isArray(obj)) {
      if (obj.length > 0 && typeof obj[0] === 'object') extractFields(obj[0], path + '[0]', results);
      return;
    }
    Object.keys(obj).forEach(function(key) {
      var val      = obj[key];
      var fullPath = path ? path + '.' + key : key;
      if (typeof val === 'number' && !isSkippable(key)) {
        results.push({ path: fullPath, key: key, value: val });
      } else if (val !== null && typeof val === 'object') {
        extractFields(val, fullPath, results);
      }
    });
  }

  // ── Render clean field cards ──────────────────────────────────
  function renderFieldList(fields) {
    var container = document.getElementById('qb-field-list');
    container.innerHTML = '';

    if (fields.length === 0) {
      container.innerHTML = '<p style="color:#64748b;">No numeric score fields found in this run.</p>';
      return;
    }

    fields.forEach(function(f) {
      var card = document.createElement('div');
      card.style.cssText = 'border:1px solid #e2e8f0; border-radius:8px; padding:0.875rem 1rem; cursor:pointer; background:#fff; transition: all 0.15s;';
      card.onmouseover = function() { this.style.borderColor='#2563eb'; this.style.background='#eff6ff'; };
      card.onmouseout  = function() { this.style.borderColor='#e2e8f0'; this.style.background='#fff'; };
      card.onclick     = function() { qbSelectField(f.path, f.value); };

      var name = document.createElement('div');
      name.style.cssText = 'font-weight:600; font-size:0.9rem; color:#1e293b; margin-bottom:0.25rem;';
      name.textContent = humanize(f.key);

      var path = document.createElement('div');
      path.style.cssText = 'font-family:monospace; font-size:0.75rem; color:#64748b; margin-bottom:0.4rem;';
      path.textContent = f.path;

      var value = document.createElement('div');
      value.style.cssText = 'font-size:1.1rem; font-weight:700; color:#2563eb;';
      value.textContent = f.value;

      card.appendChild(name);
      card.appendChild(path);
      card.appendChild(value);
      container.appendChild(card);
    });
  }

  function humanize(key) {
    return key.replace(/([A-Z])/g, ' $1').replace(/^./, function(s) { return s.toUpperCase(); }).trim();
  }

  // ── Field selected ───────────────────────────────────────────
  function qbSelectField(path, value) {
    document.getElementById('qb-value-path-input').value = path;
    document.getElementById('qb-selected-path').textContent  = humanize(path.split('.').pop());
    document.getElementById('qb-selected-value').textContent = '(' + path + ' = ' + value + ')';

    var parts = path.split('.');
    document.getElementById('qb-name').value        = humanize(parts[parts.length - 1]);
    document.getElementById('qb-description').value = '';
    document.getElementById('qb-y-axis').value      = 'Score';

    // Highlight selected card
    document.querySelectorAll('#qb-field-list div').forEach(function(c) {
      c.style.borderColor = '#e2e8f0';
      c.style.background  = '#fff';
    });

    document.getElementById('qb-step3').style.display = 'block';
    document.getElementById('qb-step3').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
