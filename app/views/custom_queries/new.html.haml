- content_for :title, "Add Query · Gumshoe"

.page-header
  %h1 Add a Custom Query
  %p.text-muted Pick a report, fetch a live run, and click the field you want to chart.

.query-builder

  / ── Step 1: Pick a report ───────────────────────────────────
  .qb-step
    .qb-step-header
      .qb-step-num 1
      %strong Pick a report
    .qb-step-body
      .qb-report-row
        %select#qb-report-select.form-input{style: "max-width: 360px;"}
          %option{value: ""} Loading reports…
        %button#qb-fetch-btn.btn.btn-primary{onclick: "qbFetchSample()", disabled: true} Fetch Fields →
      %p#qb-fetch-status.text-muted{style: "font-size: 0.82rem; margin-top: 0.5rem; display: none;"}

  / ── Step 2: Pick a field ────────────────────────────────────
  #qb-step2{style: "display: none;"}
    .qb-step{style: "margin-top: 1.5rem;"}
      .qb-step-header
        .qb-step-num 2
        %strong Pick a field to chart
      .qb-step-body
        .qb-mode-bar{style: "display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;"}
          %p.text-muted{style: "font-size: 0.85rem; margin: 0;"}
            %span#qb-mode-hint
              Fields pulled live from this report's latest run.
              %strong Start with a ⭐ Recommended field — click it to select.
          .qb-mode-toggle{style: "display: flex; border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden; flex-shrink: 0; margin-left: 1rem;"}
            %button#qb-mode-simple.qb-mode-btn.active{type: "button", onclick: "qbSetMode('simple')"} Simple
            %button#qb-mode-dev.qb-mode-btn{type: "button", onclick: "qbSetMode('developer')"} Developer

        #qb-field-list{style: "display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.75rem;"}

        #qb-raw-json-wrap{style: "display: none; margin-top: 1.25rem;"}
          %details
            %summary{style: "cursor: pointer; font-size: 0.82rem; color: #64748b; user-select: none; display: inline-flex; align-items: center; gap: 0.4rem;"}
              🔍 View raw JSON response
            #qb-json-explorer{style: "margin-top: 0.75rem; background: #0f172a; border-radius: 8px; padding: 1.25rem 1.5rem; overflow: auto; max-height: 480px; font-family: monospace; font-size: 0.78rem; line-height: 1.8; white-space: pre;"}

  / ── Step 3: Configure & save ────────────────────────────────
  #qb-step3{style: "display: none;"}
    .qb-step{style: "margin-top: 1.5rem;"}
      .qb-step-header
        .qb-step-num 3
        %strong Name it and save
      .qb-step-body
        .qb-selected-field{style: "background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; padding: 0.6rem 1rem; margin-bottom: 1.25rem; font-size: 0.875rem; color: #166534; display: flex; align-items: center; gap: 0.75rem;"}
          %span ✓ Selected:
          %strong#qb-selected-path —
          %span.text-muted#qb-selected-value{style: "font-family: monospace; font-size: 0.8rem;"}

        = form_with url: custom_queries_path, method: :post, local: true do |f|
          %input{type: "hidden", name: "custom_query[value_path]", id: "qb-value-path-input", value: ""}

          .two-col{style: "display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;"}
            .form-group
              %label{style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"} Query Name
              %input#qb-name.form-input{type: "text", name: "custom_query[name]", placeholder: "e.g. Navigation Score"}
            .form-group
              %label{style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"} Description
              %input#qb-description.form-input{type: "text", name: "custom_query[description]", placeholder: "What does this measure?"}

          .two-col{style: "display: grid; grid-template-columns: 80px 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;"}
            .form-group
              %label{style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"} Icon
              %input#qb-icon.form-input{type: "text", name: "custom_query[icon]", value: "📊", style: "font-size: 1.2rem; text-align: center;"}
            .form-group
              %label{style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"} Y-Axis Label
              %input#qb-y-axis.form-input{type: "text", name: "custom_query[y_axis_label]", value: "Score"}
            .form-group
              %label{style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"} Active
              %label{style: "display: flex; align-items: center; gap: 0.5rem; margin-top: 0.6rem; cursor: pointer;"}
                %input{type: "checkbox", name: "custom_query[active]", value: "1", checked: true}
                Show on report pages

          .btn-group
            %button.btn.btn-primary{type: "submit"} Save Query
            = link_to "Cancel", custom_queries_path, class: "btn btn-secondary"

:javascript
  // ── Mode toggle: simple (default) vs developer ───────────────
  var qbMode = 'simple';

  function qbSetMode(mode) {
    qbMode = mode;
    document.getElementById('qb-mode-simple').classList.toggle('active', mode === 'simple');
    document.getElementById('qb-mode-dev').classList.toggle('active', mode === 'developer');
    document.getElementById('qb-raw-json-wrap').style.display = mode === 'developer' ? 'block' : 'none';

    var hint = document.getElementById('qb-mode-hint');
    if (mode === 'simple') {
      hint.innerHTML = 'All available fields from this report — described in plain English. <strong>Start with a ⭐ Recommended field.</strong>';
    } else {
      hint.innerHTML = 'All available fields with API path and live value. Raw JSON response available below.';
    }

    // Re-render with current fields if already loaded
    if (window._qbLastFields) renderFieldList(window._qbLastFields);
  }

  // Keys to skip — IDs, metadata, not chartable
  var SKIP_KEYS = new Set(['id','ordinal','rank','order','count','total','page','limit','offset','status','position']);
  var SKIP_SUFFIXES = ['Id','Ids','Count','Total','Ordinal','Order','Rank','Page','Limit','Offset'];

  function isSkippable(key) {
    if (SKIP_KEYS.has(key)) return true;
    for (var i = 0; i < SKIP_SUFFIXES.length; i++) {
      if (key.endsWith(SKIP_SUFFIXES[i])) return true;
    }
    return false;
  }

  // ── Load reports on page boot ────────────────────────────────
  (function() {
    fetch('/custom_queries/api_reports')
      .then(function(r) { return r.json(); })
      .then(function(reports) {
        var sel = document.getElementById('qb-report-select');
        sel.innerHTML = '<option value="">— Select a report —</option>';
        (reports || []).forEach(function(r) {
          var brand = (r.brand || {});
          var label = brand.name || r.title || r.id;
          var opt = document.createElement('option');
          opt.value = r.id;
          opt.textContent = label;
          sel.appendChild(opt);
        });
        document.getElementById('qb-fetch-btn').disabled = false;
      })
      .catch(function() {
        document.getElementById('qb-report-select').innerHTML =
          '<option value="">Error loading reports — check your API key</option>';
      });
  })();

  // ── Fetch sample run ─────────────────────────────────────────
  function qbFetchSample() {
    var reportId = document.getElementById('qb-report-select').value;
    if (!reportId) { alert('Please select a report first.'); return; }
    var status = document.getElementById('qb-fetch-status');
    var btn    = document.getElementById('qb-fetch-btn');
    status.style.display = 'block';
    status.textContent   = 'Fetching latest run…';
    btn.disabled = true;

    fetch('/custom_queries/api_sample_run?report_id=' + encodeURIComponent(reportId))
      .then(function(r) { return r.json(); })
      .then(function(resp) {
        btn.disabled = false;
        if (resp.error) { status.textContent = 'Error: ' + resp.error; return; }
        status.textContent = 'Run #' + resp.ordinal + ' loaded — pick a field below.';
        var fields = [];
        extractFields(resp.data, '', fields);
        window._qbLastFields = fields;
        renderFieldList(fields);
        document.getElementById('qb-json-explorer').textContent = JSON.stringify(resp.data, null, 2);
        document.getElementById('qb-step2').style.display = 'block';
        document.getElementById('qb-step2').scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
      .catch(function(e) {
        btn.disabled = false;
        status.textContent = 'Error: ' + e.message;
      });
  }

  // ── Extract numeric fields recursively ───────────────────────
  function extractFields(obj, path, results) {
    if (obj === null || typeof obj !== 'object') return;
    if (Array.isArray(obj)) {
      if (obj.length > 0 && typeof obj[0] === 'object') extractFields(obj[0], path + '[0]', results);
      return;
    }
    Object.keys(obj).forEach(function(key) {
      var val      = obj[key];
      var fullPath = path ? path + '.' + key : key;
      if (typeof val === 'number' && !isSkippable(key)) {
        results.push({ path: fullPath, key: key, value: val });
      } else if (val !== null && typeof val === 'object') {
        extractFields(val, fullPath, results);
      }
    });
  }

  // ── Field catalog: plain-English names + descriptions ────────
  var FIELD_CATALOG = {
    // ── Visibility ───────────────────────────────────────────────
    'visibility.overall.visibilityScore':         { label: 'Overall Visibility Score',         desc: 'The main number — how often your brand appears across all AI answers. This is what your customers are tracking.', star: true },
    'visibility.overall.numerator':               { label: 'Overall Mentions (raw count)',      desc: 'How many answers mentioned your brand. Use Visibility Score (%) instead.', skip: true },
    'visibility.overall.denominator':             { label: 'Total Prompts Evaluated',           desc: 'Total answers analyzed in this run. Not useful as a trend line.', skip: true },
    'visibility.byModel[0].visibilityScore':      { label: 'Visibility Score — by AI Model',   desc: 'Visibility broken down per AI model (Claude, GPT-4, etc.). Plots the first model.' },
    'visibility.byModel[0].numerator':            { label: 'Model Mentions (raw count)',        desc: 'Raw mention count per model. Use the score % instead.', skip: true },
    'visibility.byModel[0].denominator':          { label: 'Model Total Prompts',               desc: 'Total prompts per model. Not useful as a trend line.', skip: true },
    'visibility.byTopic[0].visibilityScore':      { label: 'Visibility Score — by Topic',      desc: 'Visibility broken down per topic/category. Plots the first topic.' },
    'visibility.byTopic[0].numerator':            { label: 'Topic Mentions (raw count)',        desc: 'Raw mention count per topic. Use the score % instead.', skip: true },
    'visibility.byTopic[0].denominator':          { label: 'Topic Total Prompts',               desc: 'Total prompts per topic. Not useful as a trend line.', skip: true },
    'visibility.byPersona[0].visibilityScore':    { label: 'Visibility Score — by Persona',    desc: 'Visibility broken down per buyer persona. Plots the first persona.' },
    'visibility.byPersona[0].numerator':          { label: 'Persona Mentions (raw count)',      desc: 'Raw mention count per persona. Use the score % instead.', skip: true },
    'visibility.byPersona[0].denominator':        { label: 'Persona Total Prompts',             desc: 'Total prompts per persona. Not useful as a trend line.', skip: true },
    // ── Scores ───────────────────────────────────────────────────
    'scores.overallScore':                        { label: 'Overall Score',                     desc: 'Composite score across all SEO/AI optimization dimensions.', star: true },
    'scores.navigationScore':                     { label: 'Navigation Score',                  desc: 'How easily AI can crawl and understand your site structure.' },
    'scores.contentBalanceScore':                 { label: 'Content Balance Score',             desc: 'Balance of informational vs. promotional content.' },
    'scores.metadataScore':                       { label: 'Metadata Score',                    desc: 'Quality of title tags, meta descriptions, and structured metadata.' },
    'scores.pageLayoutStructureScore':            { label: 'Page Layout & Structure Score',     desc: 'Clarity of page hierarchy and visual layout signals.' },
    'scores.schemaMarkupScore':                   { label: 'Schema Markup Score',               desc: 'Presence and correctness of schema.org markup.' },
    'scores.structuredDataAssessmentScore':       { label: 'Structured Data Score',             desc: 'Overall structured data health across the site.' },
    // ── Other ────────────────────────────────────────────────────
    'sample.totalPrompts':                        { label: 'Total Prompts',                     desc: 'Number of questions evaluated. Not useful as a trend line.', skip: true },
    'sourcesTop.totals.totalSources':             { label: 'Total Sources Cited',               desc: 'How many unique sources were cited across all answers.' },
  };

  function catalogFor(path) {
    // Exact match first
    if (FIELD_CATALOG[path]) return FIELD_CATALOG[path];
    // Normalize array indices (e.g. [1] → [0]) and try again
    var normalized = path.replace(/\[\d+\]/g, '[0]');
    if (FIELD_CATALOG[normalized]) return FIELD_CATALOG[normalized];
    return null;
  }

  // ── Render clean field cards ──────────────────────────────────
  function renderFieldList(fields) {
    var container = document.getElementById('qb-field-list');
    container.innerHTML = '';

    if (fields.length === 0) {
      container.innerHTML = '<p style="color:#64748b;">No numeric score fields found in this run.</p>';
      return;
    }

    // In simple mode, show only starred. In developer mode, show all.
    var starred = [], regular = [], skippable = [];
    fields.forEach(function(f) {
      var cat = catalogFor(f.path);
      if (cat && cat.star)  starred.push({ f: f, cat: cat });
      else if (cat && cat.skip) skippable.push({ f: f, cat: cat });
      else regular.push({ f: f, cat: cat });
    });

    // Both modes show all fields — Simple uses friendly labels, Developer shows paths prominently

    function renderGroup(items, groupLabel, groupStyle) {
      if (items.length === 0) return;
      var heading = document.createElement('div');
      heading.style.cssText = 'grid-column: 1/-1; font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; margin-top:0.5rem; ' + (groupStyle || 'color:#64748b;');
      heading.textContent = groupLabel;
      container.appendChild(heading);

      items.forEach(function(item) {
        var f   = item.f;
        var cat = item.cat;
        var isSkip = cat && cat.skip;

        var card = document.createElement('div');
        card.style.cssText = 'border:1px solid ' + (cat && cat.star ? '#bbf7d0' : '#e2e8f0') + '; border-radius:8px; padding:0.875rem 1rem; cursor:pointer; background:' + (cat && cat.star ? '#f0fdf4' : '#fff') + '; transition:all 0.15s; opacity:' + (isSkip ? '0.55' : '1') + ';';
        if (!isSkip) {
          card.onmouseover = function() { this.style.borderColor='#2563eb'; this.style.background='#eff6ff'; };
          card.onmouseout  = function() { this.style.borderColor = (cat && cat.star ? '#bbf7d0' : '#e2e8f0'); this.style.background = (cat && cat.star ? '#f0fdf4' : '#fff'); };
        }
        card.onclick = function() { if (!isSkip) qbSelectField(f.path, f.value); };

        var topRow = document.createElement('div');
        topRow.style.cssText = 'display:flex; align-items:center; gap:0.4rem; margin-bottom:0.2rem;';

        if (cat && cat.star) {
          var star = document.createElement('span');
          star.textContent = '⭐';
          star.style.fontSize = '0.8rem';
          topRow.appendChild(star);
        }

        var nameEl = document.createElement('span');
        nameEl.style.cssText = 'font-weight:700; font-size:0.9rem; color:#1e293b;';
        nameEl.textContent = (cat && cat.label) ? cat.label : humanize(f.key);
        topRow.appendChild(nameEl);

        var descEl = document.createElement('div');
        descEl.style.cssText = 'font-size:0.78rem; color:#64748b; margin-bottom:0.5rem; line-height:1.5;';
        if (qbMode === 'simple') {
          // Plain English — hide path, show friendly description prominently
          descEl.textContent = (cat && cat.desc) ? cat.desc : 'Numeric field from the API response.';
        } else {
          // Developer — show path prominently, desc as secondary
          descEl.textContent = (cat && cat.desc) ? cat.desc : '';
        }

        var pathEl = document.createElement('div');
        if (qbMode === 'developer') {
          pathEl.style.cssText = 'font-family:monospace; font-size:0.78rem; color:#2563eb; font-weight:600; margin-bottom:0.4rem;';
        } else {
          pathEl.style.cssText = 'font-family:monospace; font-size:0.72rem; color:#94a3b8; margin-bottom:0.4rem;';
        }
        pathEl.textContent = f.path;

        var valueEl = document.createElement('div');
        valueEl.style.cssText = 'font-size:1.05rem; font-weight:700; color:' + (isSkip ? '#94a3b8' : '#2563eb') + ';';
        valueEl.textContent = f.value;

        card.appendChild(topRow);
        card.appendChild(descEl);
        card.appendChild(pathEl);
        card.appendChild(valueEl);
        container.appendChild(card);
      });
    }

    renderGroup(starred,   '⭐ Recommended — start here', 'color:#166534;');
    renderGroup(regular,   'All Fields');
    renderGroup(skippable, 'Raw Counts — not useful for trending', 'color:#94a3b8;');
  }

  function humanize(key) {
    return key.replace(/([A-Z])/g, ' $1').replace(/^./, function(s) { return s.toUpperCase(); }).trim();
  }

  // ── Field selected ───────────────────────────────────────────
  function qbSelectField(path, value) {
    document.getElementById('qb-value-path-input').value = path;
    document.getElementById('qb-selected-path').textContent  = humanize(path.split('.').pop());
    document.getElementById('qb-selected-value').textContent = '(' + path + ' = ' + value + ')';

    var parts = path.split('.');
    document.getElementById('qb-name').value        = humanize(parts[parts.length - 1]);
    document.getElementById('qb-description').value = '';
    document.getElementById('qb-y-axis').value      = 'Score';

    // Highlight selected card
    document.querySelectorAll('#qb-field-list div').forEach(function(c) {
      c.style.borderColor = '#e2e8f0';
      c.style.background  = '#fff';
    });

    document.getElementById('qb-step3').style.display = 'block';
    document.getElementById('qb-step3').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
