- content_for :title, "Share Access · Gumshoe"
- content_for :head do
  :css
    #query_type_group.hidden { display: none; }
  :javascript
    function toggleQuerySelect(sel) {
      var group = document.getElementById('query_type_group');
      if (group) group.classList.toggle('hidden', sel.value === '');
    }

.page-header
  %h1 Share Access
  %p.text-muted Invite a customer — they'll get a direct access link and can also log in by email

.two-col-layout{style: "display: grid; grid-template-columns: 400px 1fr; gap: 2rem; align-items: start;"}

  / ── Form ───────────────────────────────────────────────────
  .panel
    .card-header
      %h3 Generate Access Link
    .card-body
      = form_with url: invite_index_path, method: :post, local: true do |f|
        .form-group{style: "margin-bottom: 1rem;"}
          = f.label :email, "Customer Email", style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"
          = f.email_field :email,
              placeholder: "customer@company.com",
              class: "form-input",
              autocomplete: "off"
        .form-group{style: "margin-bottom: 0.5rem;"}
          = f.label :api_key, "API Key (optional)", style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"
          = f.text_field :api_key,
              placeholder: "gsorg_live_… (leave blank for customer to enter)",
              class: "form-input",
              style: "font-family: monospace; font-size: 0.85rem;",
              autocomplete: "off"
          %p.text-muted{style: "font-size: 0.78rem; margin-top: 0.35rem; line-height: 1.6;"}
            %strong{style: "color: #059669;"} Pre-filled:
            Customer clicks the link and lands directly on their reports — no setup needed.
            %br
            %strong{style: "color: #64748b;"} Left blank:
            Customer clicks the link but must enter their own API key first before seeing any data.
        .form-group{style: "margin-bottom: 0.5rem;"}
          = f.label :expires_in, "Link Expires", style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"
          = f.select :expires_in,
              [["24 hours", "1_day"], ["7 days", "7_days"], ["30 days", "30_days"], ["90 days", "90_days"], ["1 year", "1_year"], ["Never", "never"]],
              { selected: "30_days" },
              { class: "form-input" }
        .form-group{style: "margin-bottom: 0.5rem;"}
          = f.label :report_id, "Deep-link to Report (optional)", style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"
          - if @deeplink_reports.present?
            - report_options = [["— No deep link, show all reports —", ""]] + @deeplink_reports.map { |r| brand = r["brand"] || r[:brand] || {}; label = brand["name"] || brand[:name] || r["id"] || r[:id]; id = r["id"] || r[:id]; [label, id] }
            = f.select :report_id, report_options, { selected: params[:report_id] }, { class: "form-input", id: "deeplink_report_select", onchange: "toggleQuerySelect(this)" }
          - else
            %p.text-muted{style: "font-size: 0.78rem;"} Set your API key in Settings to enable deep-linking to a specific report.
        .form-group{style: "margin-bottom: 0.5rem;", id: "query_type_group", class: params[:report_id].blank? ? "hidden" : ""}
          = f.label :query_type, "Land on Query (optional)", style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"
          = f.select :query_type,
              [["— Show report overview —", ""]] + [["% Ranked #1 Trends", "trends"], ["Not Mentioned", "not_mentioned"]] + (@custom_queries || []).map { |q| [q.name, q.query_key] },
              { selected: params[:query_type] },
              { class: "form-input" }
        = f.submit "Generate Link →", class: "btn btn-primary", style: "width: 100%; margin-top: 0.75rem;"

  / ── Link output ─────────────────────────────────────────────
  .panel
    - if @access_link
      .card-header
        %h3 Access Link for #{@invited_email}
      .card-body
        %p.text-muted{style: "font-size: 0.85rem; margin-bottom: 0.75rem;"}
          Share this link with the customer. #{@expires_label}. They can also log in directly at
          = link_to "the login page", login_path
          using their email.
        - if @deep_link_report_id.present?
          %p{style: "font-size: 0.82rem; color: #059669; margin-bottom: 0.5rem;"}
            ✓ Deep-links to report
            %strong= @deep_link_report_id
            - if @deep_link_query_type.present?
              → #{@deep_link_query_type.humanize}
        .form-group
          %input.form-input{type: "text", value: @access_link, readonly: true, style: "font-family: monospace; font-size: 0.78rem;", onclick: "this.select()"}
        %button.btn.btn-secondary{style: "margin-top: 0.5rem; width: 100%;", onclick: "navigator.clipboard.writeText('#{@access_link}').then(() => { this.textContent = '✓ Copied!'; setTimeout(() => this.textContent = 'Copy Link', 2000); }); return false;"}
          Copy Link
    - else
      .card-header
        %h3 Your link will appear here
      .card-body
        %p.text-muted Fill in the form and click Generate Link.

/ ── Customer list ───────────────────────────────────────────
- if @customers.any?
  .panel{style: "margin-top: 2rem;"}
    .card-header{style: "display: flex; align-items: center; justify-content: space-between;"}
      %h3 Invited Customers
      %span.text-muted{style: "font-size: 0.8rem;"}= "#{@customers.count} #{@customers.count == 1 ? 'customer' : 'customers'}"
    %table{style: "width: 100%; border-collapse: collapse; font-size: 0.875rem;"}
      %thead
        %tr
          %th{style: "text-align: left; padding: 0.5rem 1.25rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em;"} Email
          %th{style: "text-align: left; padding: 0.5rem 1.25rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em;"} API Key
          %th{style: "text-align: left; padding: 0.5rem 1.25rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em;"} Invite Link
      %tbody
        - @customers.each do |customer|
          %tr
            %td{style: "padding: 0.65rem 1.25rem; border-bottom: 1px solid #f1f5f9; color: #1e293b; white-space: nowrap;"}= customer.email
            %td{style: "padding: 0.65rem 1.25rem; border-bottom: 1px solid #f1f5f9; color: #64748b; font-family: monospace; font-size: 0.8rem; white-space: nowrap;"}
              = customer.api_key.present? ? "#{customer.api_key[0..12]}…" : "—"
            %td{style: "padding: 0.65rem 1.25rem; border-bottom: 1px solid #f1f5f9;"}
              - if customer.invite_token.present?
                - link = access_link_url(customer.invite_token)
                - expired = customer.invite_expires_at.present? && customer.invite_expires_at < Time.current
                - if expired
                  %span{style: "color: #dc2626; font-size: 0.78rem;"} Expired
                - else
                  .invite-link-row
                    %input{type: "text", value: link, readonly: true, style: "font-family: monospace; font-size: 0.72rem; border: 1px solid #e2e8f0; border-radius: 4px; padding: 0.25rem 0.5rem; width: 260px; color: #475569;", onclick: "this.select()"}
                    %button.btn.btn-secondary.btn-sm{onclick: "navigator.clipboard.writeText('#{link}').then(() => { this.textContent = '✓'; setTimeout(() => this.textContent = 'Copy', 1500); }); return false;"} Copy
                    - if customer.invite_expires_at.present?
                      %span{style: "font-size: 0.72rem; color: #94a3b8; white-space: nowrap;"}= "exp. #{customer.invite_expires_at.strftime('%b %d, %Y')}"
              - else
                %span{style: "color: #94a3b8; font-size: 0.8rem;"} —
