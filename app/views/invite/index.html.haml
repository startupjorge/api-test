- content_for :title, "Invite · Gumshoe"

.page-header
  %h1 Invite Customers
  %p.text-muted Add customer emails so they can log in and access the same reports you see

.panel{style: "max-width: 680px;"}
  .card-header
    %h3 How to add a customer
  .card-body
    %ol{style: "margin: 0; padding-left: 1.25rem; line-height: 2.2; color: #374151;"}
      %li
        Go to your
        %strong Railway project → api-test service → Variables
      %li
        Add or update the variable:
        %br
        %code{style: "background: #f1f5f9; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.875rem;"} CUSTOMER_EMAILS
        with a comma-separated list of customer emails
      %li
        %strong Example:
        %br
        %code{style: "background: #f1f5f9; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.875rem; word-break: break-all;"} vivek@acme.com,jane@company.com,bob@startup.io
      %li Railway will redeploy automatically — customers can log in within ~3 minutes

- if @customer_emails.any?
  .panel{style: "max-width: 680px; margin-top: 1.5rem;"}
    .card-header
      %h3 Currently invited
    .card-body
      %ul{style: "margin: 0; padding-left: 1.25rem; line-height: 2;"}
        - @customer_emails.each do |email|
          %li
            %code{style: "font-size: 0.875rem;"}= email
- else
  .card{style: "max-width: 680px; margin-top: 1.5rem;"}
    .card-body
      %p.text-muted No customers invited yet. Set the CUSTOMER_EMAILS variable in Railway to get started.
