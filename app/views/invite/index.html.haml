- content_for :title, "Invite · Gumshoe"

.page-header
  %h1 Invite Customers
  %p.text-muted Add a customer's email so they can log in and access the same reports you see

- if notice
  .alert.alert-success= notice
- if alert
  .alert.alert-danger= alert

.panel{style: "max-width: 680px;"}
  .card-header
    %h3 Add Customer
  .card-body
    = form_with url: invite_index_path, method: :post, local: true do |f|
      .form-row{style: "display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: flex-end;"}
        .form-group{style: "flex: 2;"}
          %label{style: "display: block; font-weight: 600; font-size: 0.875rem; margin-bottom: 0.375rem;"} Email
          = f.email_field :email, placeholder: "vivek@acme.com", style: "width: 100%; padding: 0.6rem 0.75rem; border: 1px solid #ddd; border-radius: 4px; font-size: 0.9rem;"
        .form-group{style: "flex: 2;"}
          %label{style: "display: block; font-weight: 600; font-size: 0.875rem; margin-bottom: 0.375rem;"} Note (optional)
          = f.text_field :note, placeholder: "e.g. Vivek at Acme", style: "width: 100%; padding: 0.6rem 0.75rem; border: 1px solid #ddd; border-radius: 4px; font-size: 0.9rem;"
        = f.submit "Add →", class: "btn btn-primary", style: "white-space: nowrap; align-self: flex-end;"

    - if @customer_accesses.any?
      %table.table{style: "margin-top: 1.5rem;"}
        %thead
          %tr
            %th Email
            %th Note
            %th Added
            %th
        %tbody
          - @customer_accesses.each do |ca|
            %tr
              %td
                %code{style: "font-size: 0.875rem;"}= ca.email
              %td.text-muted= ca.note.presence || "—"
              %td.text-muted= ca.created_at.strftime("%b %d, %Y")
              %td{style: "text-align: right;"}
                = button_to "Remove", invite_path(ca, email: ca.email), method: :delete, class: "btn btn-secondary btn-sm", data: { turbo_confirm: "Remove #{ca.email}?" }
    - else
      %p.text-muted{style: "margin-top: 1rem; font-size: 0.875rem;"} No customers invited yet.
