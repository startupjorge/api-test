- content_for :title, "Share Access · Gumshoe"

.page-header
  %h1 Share Access
  %p.text-muted Invite a customer — they'll get a direct access link and can also log in by email

.two-col-layout{style: "display: grid; grid-template-columns: 400px 1fr; gap: 2rem; align-items: start;"}

  / ── Form ───────────────────────────────────────────────────
  .panel
    .card-header
      %h3 Generate Access Link
    .card-body
      = form_with url: invite_index_path, method: :post, local: true do |f|
        .form-group{style: "margin-bottom: 1rem;"}
          = f.label :email, "Customer Email", style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"
          = f.email_field :email,
              placeholder: "customer@company.com",
              class: "form-input",
              autocomplete: "off"
        .form-group{style: "margin-bottom: 0.5rem;"}
          = f.label :api_key, "API Key (optional)", style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"
          = f.text_field :api_key,
              placeholder: "gsorg_live_… (leave blank for customer to enter)",
              class: "form-input",
              style: "font-family: monospace; font-size: 0.85rem;",
              autocomplete: "off"
          %p.text-muted{style: "font-size: 0.78rem; margin-top: 0.35rem; line-height: 1.4;"}
            Leave blank — customer will be prompted to enter their own
        .form-group{style: "margin-bottom: 0.5rem;"}
          = f.label :expires_in, "Link Expires", style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"
          = f.select :expires_in,
              [["24 hours", "1_day"], ["7 days", "7_days"], ["30 days", "30_days"], ["90 days", "90_days"], ["1 year", "1_year"], ["Never", "never"]],
              { selected: "30_days" },
              { class: "form-input" }
        = f.submit "Generate Link →", class: "btn btn-primary", style: "width: 100%; margin-top: 0.75rem;"

  / ── Link output ─────────────────────────────────────────────
  .panel
    - if @access_link
      .card-header
        %h3 Access Link for #{@invited_email}
      .card-body
        %p.text-muted{style: "font-size: 0.85rem; margin-bottom: 0.75rem;"}
          Share this link with the customer. #{@expires_label}. They can also log in directly at
          = link_to "the login page", login_path
          using their email.
        .form-group
          %input.form-input{type: "text", value: @access_link, readonly: true, style: "font-family: monospace; font-size: 0.78rem;", onclick: "this.select()"}
        %button.btn.btn-secondary{style: "margin-top: 0.5rem; width: 100%;", onclick: "navigator.clipboard.writeText('#{@access_link}').then(() => { this.textContent = '✓ Copied!'; setTimeout(() => this.textContent = 'Copy Link', 2000); }); return false;"}
          Copy Link
    - else
      .card-header
        %h3 Your link will appear here
      .card-body
        %p.text-muted Fill in the form and click Generate Link.

/ ── Customer list ───────────────────────────────────────────
- if @customers.any?
  .panel{style: "margin-top: 2rem;"}
    .card-header{style: "display: flex; align-items: center; justify-content: space-between;"}
      %h3 Invited Customers
      %span.text-muted{style: "font-size: 0.8rem;"}= "#{@customers.count} #{"customer".pluralize(@customers.count)}"
    %table{style: "width: 100%; border-collapse: collapse; font-size: 0.875rem;"}
      %thead
        %tr
          %th{style: "text-align: left; padding: 0.5rem 1.25rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em;"} Email
          %th{style: "text-align: left; padding: 0.5rem 1.25rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em;"} API Key
      %tbody
        - @customers.each do |customer|
          %tr
            %td{style: "padding: 0.65rem 1.25rem; border-bottom: 1px solid #f1f5f9; color: #1e293b;"}= customer.email
            %td{style: "padding: 0.65rem 1.25rem; border-bottom: 1px solid #f1f5f9; color: #64748b; font-family: monospace; font-size: 0.8rem;"}
              = customer.api_key.present? ? "#{customer.api_key[0..12]}…" : "—"
