- content_for :title, "Share Access · Gumshoe"

.page-header
  %h1 Share Access
  %p.text-muted Generate a unique access link for a customer

.two-col-layout{style: "display: grid; grid-template-columns: 400px 1fr; gap: 2rem; align-items: start;"}

  .panel
    .card-header
      %h3 Generate Access Link
    .card-body
      = form_with url: invite_index_path, method: :post, local: true do |f|
        .form-group{style: "margin-bottom: 1rem;"}
          = f.label :email, "Customer Email", style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"
          = f.email_field :email,
              placeholder: "customer@company.com",
              class: "form-input",
              autocomplete: "off"
        .form-group{style: "margin-bottom: 0.5rem;"}
          = f.label :api_key, "API Key (optional)", style: "display: block; font-weight: 600; margin-bottom: 0.4rem; font-size: 0.875rem;"
          = f.text_field :api_key,
              placeholder: "gsorg_live_… (leave blank for customer to enter)",
              class: "form-input",
              style: "font-family: monospace; font-size: 0.85rem;",
              autocomplete: "off"
          %p.text-muted{style: "font-size: 0.78rem; margin-top: 0.35rem; line-height: 1.4;"}
            Leave blank — customer will be prompted to enter their own
        = f.submit "Generate Link →", class: "btn btn-primary", style: "width: 100%; margin-top: 0.75rem;"

  .panel
    - if @access_link
      .card-header
        %h3 Access Link for #{@invited_email}
      .card-body
        %p.text-muted{style: "font-size: 0.85rem; margin-bottom: 0.75rem;"} Share this link with the customer. It expires in 90 days.
        .form-group
          %input.form-input{type: "text", value: @access_link, readonly: true, style: "font-family: monospace; font-size: 0.78rem;", onclick: "this.select()"}
        %button.btn.btn-secondary{style: "margin-top: 0.5rem; width: 100%;", onclick: "navigator.clipboard.writeText('#{@access_link}').then(() => { this.textContent = '✓ Copied!'; setTimeout(() => this.textContent = 'Copy Link', 2000); }); return false;"}
          Copy Link
    - else
      .card-header
        %h3 Your link will appear here
      .card-body
        %p.text-muted Fill in the form and click Generate Link.
