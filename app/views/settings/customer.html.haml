.share-bar
  .share-bar-text
    🔗 This page is ready to share with your customer
    %span Copy the URL from your browser's address bar and send it directly
  %button.btn.btn-copy{onclick: "copyPageUrl(this)"} Copy Link

.page-header
  %h1 Connect Your Gumshoe Account
  %p.text-muted Enter your API key below to start exploring your brand data

.helper-box.helper-customer
  %strong Where do I find my API key?
  Log in to your Gumshoe account, go to Settings → API, and copy your key. It starts with
  %code gsorg_live_
  — paste it below and hit Connect. Your key stays in your browser only and is never stored on our server.

.panel{style: "max-width: 600px;"}
  .card-body
    = form_with url: settings_path, method: :patch, local: true do |f|
      .form-group{style: "margin-bottom: 1.25rem;"}
        = f.label :api_key, "Your API Key", style: "display: block; font-weight: 600; margin-bottom: 0.5rem; font-size: 1rem;"
        = f.text_field :api_key,
            value: session[:gumshoe_api_key],
            placeholder: "gsorg_live_...",
            style: "width: 100%; padding: 0.65rem 0.75rem; border: 1px solid #ddd; border-radius: 4px; font-family: monospace; font-size: 0.9rem;",
            autocomplete: "off"
        %p.text-muted{style: "margin-top: 0.4rem; font-size: 0.85rem;"}
          - if session[:gumshoe_api_key].present?
            %span{style: "color: #059669; font-weight: 600;"} ✓ You're connected — your data is ready to explore
          - else
            Once you paste your key and click Connect, you'll be taken straight to your reports.

      = f.hidden_field :redirect_to_reports, value: "1"
      = f.submit "Connect →", class: "btn btn-success", style: "font-size: 1rem; padding: 0.65rem 2rem;"
