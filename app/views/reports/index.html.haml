.page-header
  %h1 Select a Report & Query

.workflow-steps
  .workflow-step
    .workflow-step-num 1
    .workflow-step-text
      %strong Pick a report
      %span from the list below
  .workflow-step-arrow →
  .workflow-step
    .workflow-step-num 2
    .workflow-step-text
      %strong Choose a query
      %span % Ranked #1 or Not Mentioned or create custom
  .workflow-step-arrow →
  .workflow-step
    .workflow-step-num 3
    .workflow-step-text
      %strong Run it
      %span results appear instantly

- if @error
  .alert.alert-danger= @error

- if @reports && @reports.any?
  %table.table
    %thead
      %tr
        %th Report
        %th Brand
        %th Status
        %th Created
    %tbody
      - @reports.each do |report|
        - report_id = report['id'] || report[:id]
        - title = report['title'] || report[:title]
        - brand = report['brand'] || report[:brand]
        - status = report['status'] || report[:status]
        - created_at = report['createdAt'] || report[:created_at]
        %tr{style: "cursor: pointer;", onclick: "window.location='#{report_path(report_id)}'"}
          %td
            %strong= title || 'Untitled'
            %div{style: "font-size: 0.78rem; color: #9ca3af; font-family: monospace; margin-top: 2px;"}= report_id
          %td= brand ? (brand['name'] || brand[:name] || '—') : '—'
          %td
            %span.status{class: status&.downcase}= status&.capitalize || '—'
          %td.text-muted
            - if created_at
              = Time.parse(created_at).strftime("%b %d, %Y") rescue created_at
            - else
              —

  - if @prev_token || @next_token
    .pagination
      - if @prev_token
        = link_to "← Previous", reports_path(request.query_parameters.merge(token: @prev_token)), class: "btn btn-secondary"
      - if @next_token
        = link_to "Next →", reports_path(request.query_parameters.merge(token: @next_token)), class: "btn btn-secondary"
- else
  .card
    .card-body
      %p.text-muted No reports found. Make sure your API key is set in Settings.
