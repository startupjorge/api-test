.page-header{style: "display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 1rem;"}
  %div
    %h1 Reports
    %p.text-muted Your Gumshoe reports — click any report to explore its data

- if @error
  .alert.alert-danger
    %strong Error:
    = @error

- if @reports && @reports.any?
  %table.table
    %thead
      %tr
        %th Report
        %th Brand
        %th Status
        %th Created
        %th{style: "text-align: right;"} Actions
    %tbody
      - @reports.each do |report|
        - report_id = report['id'] || report[:id]
        - title = report['title'] || report[:title]
        - brand = report['brand'] || report[:brand]
        - status = report['status'] || report[:status]
        - created_at = report['createdAt'] || report[:created_at]
        %tr
          %td
            = link_to report_path(report_id), style: "text-decoration: none;" do
              %strong{style: "color: #1a2332;"}= title || 'Untitled'
              %div{style: "font-size: 0.78rem; color: #9ca3af; font-family: monospace; margin-top: 2px;"}= report_id
          %td= brand ? (brand['name'] || brand[:name] || '—') : '—'
          %td
            %span.status{class: status&.downcase}= status&.capitalize || '—'
          %td.text-muted
            - if created_at
              = Time.parse(created_at).strftime("%b %d, %Y") rescue created_at
            - else
              —
          %td{style: "text-align: right;"}
            .btn-group{style: "justify-content: flex-end;"}
              - if report_id
                = link_to "Open →", report_path(report_id), class: "btn btn-primary btn-sm"
                = link_to "📈 Trends", customer_trends_report_path(report_id), class: "btn btn-outline btn-sm"

  - if @prev_token || @next_token
    .pagination
      - if @prev_token
        = link_to "← Previous", reports_path(request.query_parameters.merge(token: @prev_token)), class: "btn btn-secondary"
      - if @next_token
        = link_to "Next →", reports_path(request.query_parameters.merge(token: @next_token)), class: "btn btn-secondary"
- else
  .card
    .card-body
      %p.text-muted No reports found.

.panel.panel-internal{style: "margin-top: 1.5rem;"}
  .panel-header{onclick: "togglePanel(this)"}
    %span.badge.badge-internal Internal
    %h3 API Debug
    %span.panel-toggle ▼
  .panel-body.hidden
    - if @curl_command
      .debug-block
        .debug-label curl command
        %code= @curl_command

:javascript
  function togglePanel(header) {
    const body = header.nextElementSibling;
    const toggle = header.querySelector('.panel-toggle');
    body.classList.toggle('hidden');
    toggle.classList.toggle('open');
  }
