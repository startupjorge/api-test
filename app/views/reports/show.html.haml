- content_for :head do
  %script{src: "https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"}

- title = @report.is_a?(Hash) ? (@report["title"] || @report[:title] || "Report #{@report_id}") : "Report #{@report_id}"

.breadcrumb
  = link_to "Reports", reports_path
  %span.breadcrumb-sep /
  %span= title

.page-header
  %h1= title
  - if @brand_name
    %p.text-muted Brand: #{@brand_name}

= form_with url: report_path(@report_id), method: :get, local: true do |f|

  .test-step
    .test-step-label Choose a query
    .query-cards
      .query-card{id: "card-trends", onclick: "document.getElementById('qt_trends').click()"}
        = f.radio_button :query_type, "trends", id: "qt_trends", checked: @query_type != "not_mentioned" && @active_custom_query.nil?
        %label.query-card-label{for: "qt_trends"}
          .query-card-icon 📈
          .query-card-content
            %strong % Results Ranked #1
            %p How often each brand appears as the #1 AI answer across all runs

      .query-card{id: "card-not_mentioned", onclick: "document.getElementById('qt_not_mentioned').click()"}
        = f.radio_button :query_type, "not_mentioned", id: "qt_not_mentioned", checked: @query_type == "not_mentioned"
        %label.query-card-label{for: "qt_not_mentioned"}
          .query-card-icon 🔍
          .query-card-content
            %strong Not Mentioned
            %p Conversations where your brand was completely absent from AI answers

      .query-card{id: "card-prompt_explorer", onclick: "document.getElementById('qt_prompt_explorer').click()"}
        = f.radio_button :query_type, "prompt_explorer", id: "qt_prompt_explorer", checked: @query_type == "prompt_explorer"
        %label.query-card-label{for: "qt_prompt_explorer"}
          .query-card-icon 🧵
          .query-card-content
            %strong Prompt Explorer
            %p Every question, answer, brand mention, and citation — filterable by model and persona

      - @custom_queries.each do |cq|
        - cq_id = "card-#{cq.query_key}"
        - radio_id = "qt_#{cq.query_key}"
        .query-card{id: cq_id, onclick: "document.getElementById('#{radio_id}').click()"}
          = f.radio_button :query_type, cq.query_key, id: radio_id, checked: @query_type == cq.query_key
          %label.query-card-label{for: radio_id}
            .query-card-icon= cq.icon
            .query-card-content
              %strong= cq.name
              %p= cq.description

    - if employee?
      = link_to "＋ Add Query", new_custom_query_path, class: "btn btn-secondary btn-sm", style: "margin-top: 0.75rem; display: inline-flex;"

  #brand-key-group{style: "display: none; margin-bottom: 1.5rem;"}
    .test-step-label Brand key
    = f.text_field :brand_key, value: @brand_key, placeholder: "e.g. shipiumcom", class: "form-control", style: "max-width: 320px;"

  .test-step
    = f.submit "Run →", class: "btn btn-primary btn-lg"

- if @error
  .alert.alert-danger{style: "margin-top: 1.5rem;"}= @error

- if @query_type == "trends" && @chart_datasets.present?
  .result-panel{style: "margin-top: 2rem;"}
    .result-panel-header
      %span.result-panel-title 📈 % Results Ranked #1
      %span.result-panel-sub Computed from API response
    .result-panel-body
      %canvas#reportTrendsChart{style: "width: 100%; height: 400px;"}
  :javascript
    (function() {
      const rawLabels = #{@chart_labels.to_json};
      const labels = rawLabels.map(l => {
        const d = new Date(l);
        return isNaN(d) ? l : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      });
      const palette = ['#2563eb','#16a34a','#dc2626','#d97706','#7c3aed','#0891b2','#db2777','#65a30d','#ea580c','#6b7280'];
      const allDatasets = #{@chart_datasets.to_json};
      const scored = allDatasets.map(ds => ({ ...ds, peak: Math.max(...ds.data) })).sort((a, b) => b.peak - a.peak);
      const datasets = [
        ...scored.slice(0,10).map((ds,i) => ({
          label: ds.label, data: ds.data,
          borderColor: palette[i % palette.length],
          backgroundColor: palette[i % palette.length] + '22',
          tension: 0.3, pointRadius: 4, fill: false, hidden: false
        })),
        ...scored.slice(10).map(ds => ({
          label: ds.label, data: ds.data,
          borderColor: '#ccc', backgroundColor: '#cccccc22',
          tension: 0.3, pointRadius: 2, fill: false, hidden: true
        }))
      ];
      new Chart(document.getElementById('reportTrendsChart'), {
        type: 'line',
        data: { labels, datasets },
        options: {
          responsive: true,
          plugins: {
            legend: { position: 'bottom', labels: { filter: i => !i.hidden, boxWidth: 12, font: { size: 11 } } },
            tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: ${ctx.parsed.y}%` } }
          },
          scales: {
            y: { min: 0, max: 100, ticks: { callback: v => v + '%' }, title: { display: true, text: '% Ranked #1' } },
            x: { title: { display: true, text: 'Run Date' } }
          }
        }
      });
    })();

- elsif @query_type == "not_mentioned"
  .result-panel{style: "margin-top: 2rem;"}
    .result-panel-header
      %span.result-panel-title 🔍 Not Mentioned
      %span.result-panel-sub Conversations where #{@brand_key} was absent
    .result-panel-body
      - if @total_answers.to_i > 0
        .stats-row{style: "margin-bottom: 1.5rem;"}
          .stat-card
            .stat-number{style: "color: #dc2626;"}= @not_mentioned.size
            .stat-label Not Mentioned
          .stat-card
            .stat-number{style: "color: #dc2626;"}= "#{@total_answers > 0 ? (@not_mentioned.size.to_f / @total_answers * 100).round(1) : 0}%"
            .stat-label of Conversations
          .stat-card
            .stat-number{style: "color: #059669;"}= @total_answers - @not_mentioned.size
            .stat-label Was Mentioned
        - if @not_mentioned.any?
          - @not_mentioned.each do |answer|
            .answer-card
              .meta
                %span
                  %strong Persona:
                  = answer[:persona_name]
                %span
                  %strong Model:
                  = answer[:model].presence || "—"
              .question= answer[:question_text]
              .answer-text= answer[:answer_text]
        - else
          %p.text-muted #{@brand_key} appeared in every conversation in this run.
      - else
        %p.text-muted No data found.

- if @query_type == "prompt_explorer"
  .result-panel{style: "margin-top: 2rem;"}
    .result-panel-header
      %span.result-panel-title 🧵 Prompt Explorer
      - if @explorer_runs.present?
        %span.result-panel-sub{style: "display: flex; align-items: center; gap: 0.5rem;"}
          Run:
          = form_with url: report_path(@report_id), method: :get, local: true, style: "display: inline;" do |rf|
            = rf.hidden_field :query_type, value: "prompt_explorer"
            = rf.hidden_field :brand_key,  value: @brand_key
            = rf.select :ordinal,
                @explorer_runs.map { |r| ["Run ##{r["ordinal"] || r[:ordinal]} — #{((r["createdAt"] || r[:created_at]).to_s[0,10] rescue r["ordinal"])}", r["ordinal"] || r[:ordinal]] },
                { selected: @explorer_ordinal },
                { class: "form-input", style: "font-size: 0.8rem; padding: 0.2rem 0.5rem; display: inline; width: auto;", onchange: "this.form.submit()" }
    .result-panel-body
      - if @prompt_rows.present?
        - mentioned_count   = @prompt_rows.count { |r| r[:brand_mentioned] }
        - unmentioned_count = @prompt_rows.count { |r| !r[:brand_mentioned] }
        .stats-row{style: "margin-bottom: 1.5rem;"}
          .stat-card
            .stat-number= @prompt_rows.size
            .stat-label Total Prompts
          .stat-card
            .stat-number{style: "color: #059669;"}= mentioned_count
            .stat-label Mentioned
          .stat-card
            .stat-number{style: "color: #dc2626;"}= unmentioned_count
            .stat-label Not Mentioned
          .stat-card
            .stat-number{style: "color: #059669;"}= "#{@prompt_rows.size > 0 ? (mentioned_count.to_f / @prompt_rows.size * 100).round(1) : 0}%"
            .stat-label Mention Rate

        / Filter bar
        .filter-bar{style: "display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; align-items: center;"}
          %span{style: "font-size: 0.8rem; font-weight: 600; color: #64748b;"} Filter:
          %button.filter-btn.active{type: "button", onclick: "filterPrompts('all', this)",        style: "font-size: 0.78rem;"} All
          %button.filter-btn{type: "button",        onclick: "filterPrompts('mentioned', this)",  style: "font-size: 0.78rem;"} Mentioned
          %button.filter-btn{type: "button",        onclick: "filterPrompts('not_mentioned', this)", style: "font-size: 0.78rem;"} Not Mentioned
          - if @explorer_models.size > 1
            %span{style: "margin-left: 0.75rem; font-size: 0.8rem; font-weight: 600; color: #64748b;"} Model:
            - @explorer_models.each do |model|
              %button.filter-btn.model-filter{type: "button", "data-model": model, onclick: "filterModel(this)", style: "font-size: 0.78rem;"}= model.split("-").first(3).join("-")
          - if @explorer_personas.size > 1
            %span{style: "margin-left: 0.75rem; font-size: 0.8rem; font-weight: 600; color: #64748b;"} Persona:
            - @explorer_personas.each do |persona|
              %button.filter-btn.persona-filter{type: "button", "data-persona": persona, onclick: "filterPersona(this)", style: "font-size: 0.78rem;"}= persona

        / Table
        .table-scroll{style: "overflow-x: auto;"}
          %table.prompt-table{style: "width: 100%; border-collapse: collapse; font-size: 0.82rem;"}
            %thead
              %tr
                %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 2px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; white-space: nowrap;"} Question
                %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 2px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; white-space: nowrap;"} Persona
                %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 2px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; white-space: nowrap;"} Model
                %th{style: "text-align: center; padding: 0.5rem 0.75rem; border-bottom: 2px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; white-space: nowrap;"} Brand Rank
                %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 2px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; white-space: nowrap;"} Top Competitor
                %th{style: "text-align: left; padding: 0.5rem 0.75rem; border-bottom: 2px solid #e2e8f0; color: #6b7280; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; white-space: nowrap;"} Top Citation
            %tbody#promptTableBody
              - @prompt_rows.each_with_index do |row, i|
                %tr.prompt-row{"data-mentioned": row[:brand_mentioned].to_s, "data-model": row[:model], "data-persona": row[:persona], style: "background: #{i.even? ? '#fff' : '#f8fafc'};"}
                  %td{style: "padding: 0.6rem 0.75rem; border-bottom: 1px solid #f1f5f9; max-width: 380px; line-height: 1.5;"}= row[:question]
                  %td{style: "padding: 0.6rem 0.75rem; border-bottom: 1px solid #f1f5f9; white-space: nowrap; color: #475569;"}= row[:persona]
                  %td{style: "padding: 0.6rem 0.75rem; border-bottom: 1px solid #f1f5f9; white-space: nowrap; font-family: monospace; font-size: 0.75rem; color: #64748b;"}= row[:model]
                  %td{style: "padding: 0.6rem 0.75rem; border-bottom: 1px solid #f1f5f9; text-align: center;"}
                    - if row[:brand_rank]
                      %span{style: "display: inline-block; padding: 0.15rem 0.5rem; border-radius: 9999px; font-weight: 700; font-size: 0.78rem; background: #{row[:brand_rank] == 1 ? '#dcfce7' : '#fef9c3'}; color: #{row[:brand_rank] == 1 ? '#166534' : '#854d0e'};"}= "##{row[:brand_rank]}"
                    - else
                      %span{style: "display: inline-block; padding: 0.15rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; background: #fee2e2; color: #991b1b; font-weight: 600;"} —
                  %td{style: "padding: 0.6rem 0.75rem; border-bottom: 1px solid #f1f5f9; white-space: nowrap; color: #475569;"}= row[:top_competitor] || "—"
                  %td{style: "padding: 0.6rem 0.75rem; border-bottom: 1px solid #f1f5f9; color: #64748b; font-size: 0.78rem;"}
                    - if row[:top_citation]
                      = row[:top_citation]
                      - if row[:citation_count] > 1
                        %span{style: "color: #94a3b8;"} +#{row[:citation_count] - 1}
                    - else
                      —
      - else
        %p.text-muted No prompt data found for this run.

  :javascript
    (function() {
      var currentMention  = 'all';
      var currentModel    = null;
      var currentPersona  = null;

      function applyFilters() {
        document.querySelectorAll('#promptTableBody .prompt-row').forEach(function(row) {
          var mentionMatch  = currentMention === 'all'
            || (currentMention === 'mentioned'     && row.dataset.mentioned === 'true')
            || (currentMention === 'not_mentioned' && row.dataset.mentioned === 'false');
          var modelMatch    = !currentModel   || row.dataset.model   === currentModel;
          var personaMatch  = !currentPersona || row.dataset.persona === currentPersona;
          row.style.display = (mentionMatch && modelMatch && personaMatch) ? '' : 'none';
        });
      }

      window.filterPrompts = function(type, btn) {
        currentMention = type;
        document.querySelectorAll('.filter-btn:not(.model-filter):not(.persona-filter)').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        applyFilters();
      };

      window.filterModel = function(btn) {
        var model = btn.dataset.model;
        if (currentModel === model) {
          currentModel = null;
          btn.classList.remove('active');
        } else {
          document.querySelectorAll('.model-filter').forEach(function(b) { b.classList.remove('active'); });
          currentModel = model;
          btn.classList.add('active');
        }
        applyFilters();
      };

      window.filterPersona = function(btn) {
        var persona = btn.dataset.persona;
        if (currentPersona === persona) {
          currentPersona = null;
          btn.classList.remove('active');
        } else {
          document.querySelectorAll('.persona-filter').forEach(function(b) { b.classList.remove('active'); });
          currentPersona = persona;
          btn.classList.add('active');
        }
        applyFilters();
      };
    })();

- if @active_custom_query && @chart_datasets.present?
  .result-panel{style: "margin-top: 2rem;"}
    .result-panel-header
      %span.result-panel-title= "#{@active_custom_query.icon} #{@active_custom_query.name}"
      %span.result-panel-sub= @active_custom_query.description
    .result-panel-body
      %canvas#customQueryChart{style: "width: 100%; height: 400px;"}
  :javascript
    (function() {
      const rawLabels = #{@chart_labels.to_json};
      const labels = rawLabels.map(l => {
        const d = new Date(l);
        return isNaN(d) ? l : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      });
      const ds = #{@chart_datasets.to_json}[0];
      new Chart(document.getElementById('customQueryChart'), {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: ds.label,
            data: ds.data,
            borderColor: '#2563eb',
            backgroundColor: '#2563eb22',
            tension: 0.3,
            pointRadius: 4,
            fill: false
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: ${ctx.parsed.y}` } }
          },
          scales: {
            y: { title: { display: true, text: #{@chart_y_label.to_json} } },
            x: { title: { display: true, text: 'Run Date' } }
          }
        }
      });
    })();

- if @query_type.present?
  %details.api-how-to{style: "margin-top: 2rem;", open: true}
    %summary.api-how-to-toggle
      %span 🔌 How to call this API
      %span.api-how-to-docs-link= link_to "Full API docs →", "https://app.gumshoe.ai/openapi", target: "_blank", onclick: "event.stopPropagation();"
    .api-how-to-body
      - if @query_type == "trends"
        %p.api-how-to-intro
          This chart is built by fetching all runs for a report, then pulling the raw results for each run and computing the % of conversations where each brand was ranked #1.
        .api-how-to-steps
          .api-how-to-step
            %span.step-num 1
            .step-content
              %strong List runs for a report
              %code.api-endpoint GET /v1/reports/#{@report_id}/runs
              - runs_call = @api_calls&.find { |c| c[:url].to_s.include?("/runs") && !c[:url].to_s.match?(%r{/runs/\d}) }
              - if runs_call
                %pre.api-curl= runs_call[:curl]
          .api-how-to-step
            %span.step-num 2
            .step-content
              %strong Fetch raw results for each run
              %code.api-endpoint GET /v1/reports/#{@report_id}/runs/:ordinal/raw
              - raw_call = @api_calls&.find { |c| c[:url].to_s.include?("/raw") }
              - if raw_call
                %pre.api-curl= raw_call[:curl]
          .api-how-to-step
            %span.step-num 3
            .step-content
              %strong Compute % Ranked #1
              %p.text-muted For each answer in the raw response, check #{"`"}mentions[].rank == 1#{"`"} and tally by brand key. Divide by total answers to get the percentage.
      - elsif @query_type == "prompt_explorer"
        %p.api-how-to-intro
          Prompt Explorer pulls the full raw results for a single run — every question, every AI answer, every brand mention and citation.
        .api-how-to-steps
          .api-how-to-step
            %span.step-num 1
            .step-content
              %strong Fetch raw results for a run
              %code.api-endpoint GET /v1/reports/#{@report_id}/runs/#{@explorer_ordinal}/raw
              - raw_call = @api_calls&.find { |c| c[:url].to_s.include?("/raw") }
              - if raw_call
                %pre.api-curl= raw_call[:curl]
          .api-how-to-step
            %span.step-num 2
            .step-content
              %strong Walk the response tree
              %pre.api-curl
                :preserve
                  personas[].questions[].answers[].mentions[]
                  # Each mention has: rank, brand.key, brand.name, reason
                  # Each answer has:  model.name, citations[].domain
          .api-how-to-step
            %span.step-num 3
            .step-content
              %strong Check if brand was mentioned
              %pre.api-curl
                :preserve
                  mentioned = answer["mentions"].any? do |m|
                    m.dig("brand", "key") == "#{@brand_key}"
                  end
      - elsif @query_type == "not_mentioned"
        %p.api-how-to-intro
          Not Mentioned is computed from the raw run results. Any conversation where your brand key does not appear in #{"`"}mentions[].brand.key#{"`"} is counted as not mentioned.
        .api-how-to-steps
          .api-how-to-step
            %span.step-num 1
            .step-content
              %strong Fetch raw results for a run
              %code.api-endpoint GET /v1/reports/#{@report_id}/runs/#{@ordinal}/raw
              - raw_call = @api_calls&.find { |c| c[:url].to_s.include?("/raw") }
              - if raw_call
                %pre.api-curl= raw_call[:curl]
          .api-how-to-step
            %span.step-num 2
            .step-content
              %strong Filter for not mentioned
              %p.text-muted For each answer, check whether #{"`"}mentions[].brand.key#{"`"} contains #{"`"}#{@brand_key}#{"`"}. If absent, that conversation was not mentioned.
          .api-how-to-step
            %span.step-num 3
            .step-content
              %strong Example filter logic
              %pre.api-curl
                :preserve
                  not_mentioned = answers.reject do |answer|
                    answer["mentions"].any? do |m|
                      m.dig("brand", "key") == "#{@brand_key}"
                    end
                  end
:javascript
  (function() {
    const radios = document.querySelectorAll('input[name="query_type"]');
    const brandGroup = document.getElementById('brand-key-group');

    function updateUI() {
      const selected = document.querySelector('input[name="query_type"]:checked');
      document.querySelectorAll('.query-card').forEach(c => c.classList.remove('query-card-selected'));
      if (selected) {
        document.getElementById('card-' + selected.value)?.classList.add('query-card-selected');
        brandGroup.style.display = (selected.value === 'not_mentioned' || selected.value === 'prompt_explorer') ? 'block' : 'none';
      }
    }

    radios.forEach(r => r.addEventListener('change', updateUI));
    updateUI();
  })();
