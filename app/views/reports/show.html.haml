- if @error
  .alert.alert-danger
    %strong Error:
    = @error
- elsif @report
  - report_id = params[:id]
  - title = @report['title'] || @report[:title] || "Report #{report_id}"
  - brand = @report['brand'] || @report[:brand]
  - brand_name = brand ? (brand['name'] || brand[:name]) : nil
  - brand_key = brand ? (brand['key'] || brand[:key]) : nil
  - status = @report['status'] || @report[:status]
  - latest_ordinal = @latest_ordinal || (@runs&.any? ? (@runs.map { |r| r['ordinal'] || r[:ordinal] }.compact.max || 1) : 1)

  .breadcrumb
    = link_to "Reports", reports_path
    %span.breadcrumb-sep /
    %span= title

  .page-header{style: "display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;"}
    %div
      %h1= title
      %p.text-muted
        - if brand_name
          Brand: #{brand_name}
          ·
        - if status
          %span.status{class: status&.downcase}= status&.capitalize
        - if @runs&.any?
          · #{@runs.count} #{"run".pluralize(@runs.count)}
        · ID:
        %code{style: "font-size: 0.8rem;"}= report_id

  / ── Latest Run Stats ──────────────────────────────────────
  - if @latest_stats && @latest_stats[:total] > 0
    .stats-section
      %h3.stats-section-title
        Latest Run Stats
        %span.stats-run-label Run #{latest_ordinal}
      .stats-brands
        - sorted = @latest_stats[:brand_names].sort_by { |bkey, _| -(@latest_stats[:brand_counts][bkey] || 0) }
        - sorted.each do |bkey, bname|
          - ranked1 = @latest_stats[:brand_counts][bkey] || 0
          - not_mentioned = @latest_stats[:not_mentioned_counts][bkey] || 0
          - total = @latest_stats[:total]
          - pct = total > 0 ? (ranked1.to_f / total * 100).round(1) : 0
          .brand-stat-row
            .brand-stat-name= bname
            .brand-stat-pills
              .stat-pill.stat-pill-green
                %span.pill-label % Ranked #1
                %span.pill-value= "#{pct}%"
              .stat-pill.stat-pill-red
                %span.pill-label Not Mentioned
                %span.pill-value= not_mentioned
              - if brand_key == bkey
                = link_to "View →", not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal, brand_key: bkey), class: "btn btn-outline btn-xs"

  / ── API Calls ──────────────────────────────────────────────
  .feature-grid
    .feature-card
      .feature-card-icon 📈
      %h3 % Results Ranked #1
      %p How often each brand appears as the #1 AI answer across every run — track momentum over time.
      .feature-card-actions
        = link_to "View Chart", trends_report_path(report_id), class: "btn btn-primary btn-sm"
        = link_to "📤 Share Externally", customer_trends_report_path(report_id), class: "btn btn-share btn-sm"
    .feature-card
      .feature-card-icon 🔍
      %h3 Not Mentioned
      %p Every AI conversation where a specific brand was completely absent — your competitive gap finder.
      .feature-card-actions
        - if brand_key.present?
          = link_to "View Results", not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal, brand_key: brand_key), class: "btn btn-primary btn-sm"
          = link_to "📤 Share Externally", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal, brand_key: brand_key), class: "btn btn-share btn-sm"
        - else
          = link_to "View Results", not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal), class: "btn btn-primary btn-sm"
          = link_to "📤 Share Externally", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal), class: "btn btn-share btn-sm"

  / ── Runs ────────────────────────────────────────────────
  - if @runs && @runs.any?
    .panel{style: "margin-top: 1.5rem;"}
      .card-header
        %h3 All Runs
        %span.text-muted{style: "font-size: 0.8rem;"} #{@runs.count} total
      %table.table{style: "border-radius: 0; box-shadow: none;"}
        %thead
          %tr
            %th Run
            %th Date
            %th{style: "text-align: right;"} Share Externally
        %tbody
          - @runs.each do |run|
            - ordinal = run['ordinal'] || run[:ordinal]
            - created_at = run['createdAt'] || run['created_at'] || run[:created_at]
            %tr
              %td
                %strong Run #{ordinal}
              %td.text-muted
                - if created_at
                  = Time.parse(created_at).strftime("%b %d, %Y") rescue created_at
                - else
                  —
              %td{style: "text-align: right;"}
                - if brand_key.present?
                  = link_to "📤 Not Mentioned", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: ordinal, brand_key: brand_key), class: "btn btn-share btn-sm"
                - else
                  = link_to "📤 Not Mentioned", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: ordinal), class: "btn btn-share btn-sm"

:javascript
  function togglePanel(header) {
    const body = header.nextElementSibling;
    const toggle = header.querySelector('.panel-toggle');
    body.classList.toggle('hidden');
    toggle.classList.toggle('open');
  }
