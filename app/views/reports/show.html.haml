- if @error
  .alert.alert-danger
    %strong Error:
    = @error
- elsif @report
  - report_id = params[:id]
  - title = @report['title'] || @report[:title] || "Report #{report_id}"
  - brand = @report['brand'] || @report[:brand]
  - brand_name = brand ? (brand['name'] || brand[:name]) : nil
  - brand_key = brand ? (brand['key'] || brand[:key]) : nil
  - status = @report['status'] || @report[:status]
  - latest_ordinal = @runs&.any? ? (@runs.map { |r| r['ordinal'] || r[:ordinal] }.compact.max || 1) : 1

  .breadcrumb
    = link_to "Reports", reports_path
    %span.breadcrumb-sep /
    %span= title

  .page-header{style: "display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;"}
    %div
      %h1= title
      %p.text-muted
        - if brand_name
          Brand: #{brand_name}
          ·
        - if status
          %span.status{class: status&.downcase}= status&.capitalize
        - if @runs&.any?
          · #{@runs.count} #{"run".pluralize(@runs.count)}
        · ID:
        %code{style: "font-size: 0.8rem;"}= report_id

  / ── Feature cards ──────────────────────────────────────
  .feature-grid
    .feature-card
      .feature-card-icon 📈
      %h3 Rank Trends
      %p How often each brand appears as the #1 AI answer — plotted across every run so you can see momentum and changes over time.
      .feature-card-actions
        = link_to "View Chart", trends_report_path(report_id), class: "btn btn-primary btn-sm"
        = link_to "Share →", customer_trends_report_path(report_id), class: "btn btn-outline btn-sm"
    .feature-card
      .feature-card-icon 🔍
      %h3 Not Mentioned
      %p Every AI conversation where a specific brand was completely absent — your competitive gap finder.
      .feature-card-actions
        - if brand_key.present?
          = link_to "Browse", not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal, brand_key: brand_key), class: "btn btn-primary btn-sm"
          = link_to "Share →", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal, brand_key: brand_key), class: "btn btn-outline btn-sm"
        - else
          = link_to "Browse", not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal), class: "btn btn-primary btn-sm"
          = link_to "Share →", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal), class: "btn btn-outline btn-sm"

  / ── Runs ────────────────────────────────────────────────
  - if @runs && @runs.any?
    .panel
      .card-header
        %h3 Runs
        %span.text-muted{style: "font-size: 0.8rem;"} #{@runs.count} total
      %table.table{style: "border-radius: 0; box-shadow: none;"}
        %thead
          %tr
            %th Run
            %th Date
            %th{style: "text-align: right;"} Actions
        %tbody
          - @runs.each do |run|
            - ordinal = run['ordinal'] || run[:ordinal]
            - created_at = run['createdAt'] || run['created_at'] || run[:created_at]
            %tr
              %td
                %strong Run #{ordinal}
              %td.text-muted
                - if created_at
                  = Time.parse(created_at).strftime("%b %d, %Y") rescue created_at
                - else
                  —
              %td{style: "text-align: right;"}
                .btn-group{style: "justify-content: flex-end;"}
                  = link_to "View", report_run_path(report_id: report_id, ordinal: ordinal), class: "btn btn-secondary btn-sm"
                  - if brand_key.present?
                    = link_to "Not Mentioned", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: ordinal, brand_key: brand_key), class: "btn btn-outline btn-sm"
                  - else
                    = link_to "Not Mentioned", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: ordinal), class: "btn btn-outline btn-sm"
  - else
    .card
      .card-body
        %p.text-muted No runs found for this report.

  / ── Internal debug ──────────────────────────────────────
  .panel.panel-internal{style: "margin-top: 1rem;"}
    .panel-header{onclick: "togglePanel(this)"}
      %span.badge.badge-internal Internal
      %h3 API Debug
      %span.panel-toggle ▼
    .panel-body.hidden
      - if @curl_command
        .debug-block
          .debug-label curl command
          %code= @curl_command
      .report-details.mt-2
        %dl
          - @report.each do |key, value|
            - next if key.to_s == 'runs'
            %dt= key.to_s.humanize
            %dd
              - if value.is_a?(Hash) || value.is_a?(Array)
                %pre= JSON.pretty_generate(value)
              - else
                = value

:javascript
  function togglePanel(header) {
    const body = header.nextElementSibling;
    const toggle = header.querySelector('.panel-toggle');
    body.classList.toggle('hidden');
    toggle.classList.toggle('open');
  }
