- if @error
  .alert.alert-danger
    %strong Error:
    = @error
- elsif @report
  - report_id = params[:id]
  - title = @report['title'] || @report[:title] || "Report #{report_id}"
  - brand = @report['brand'] || @report[:brand]
  - brand_name = brand ? (brand['name'] || brand[:name]) : nil
  - brand_key = brand ? (brand['key'] || brand[:key]) : nil
  - status = @report['status'] || @report[:status]
  - latest_ordinal = @latest_ordinal || (@runs&.any? ? (@runs.map { |r| r['ordinal'] || r[:ordinal] }.compact.max || 1) : 1)

  .breadcrumb
    = link_to "Reports", reports_path
    %span.breadcrumb-sep /
    %span= title

  .page-header
    %h1= title
    %p.text-muted
      - if brand_name
        Brand: #{brand_name} ·
      - if status
        %span.status{class: status&.downcase}= status&.capitalize
      · ID:
      %code{style: "font-size: 0.8rem;"}= report_id

  / ── % Results Ranked #1 ─────────────────────────────────────
  .panel{style: "margin-bottom: 1.5rem;"}
    .card-header{style: "display: flex; align-items: center; justify-content: space-between;"}
      %div
        %h3 📈 % Results Ranked #1
        %p.text-muted{style: "font-size: 0.8rem; margin: 0;"} How often each brand appears as the #1 AI answer
      .card-header-actions
        = link_to "View Chart →", trends_report_path(report_id), class: "btn btn-primary btn-sm"
        = link_to "📤 Share", customer_trends_report_path(report_id), class: "btn btn-share btn-sm"
    .card-body
      - if @latest_stats && @latest_stats[:total] > 0
        %p.text-muted{style: "font-size: 0.8rem; margin-bottom: 1rem;"} Latest run (Run #{latest_ordinal}) · #{@latest_stats[:total]} total answers
        - sorted = @latest_stats[:brand_names].sort_by { |bkey, _| -(@latest_stats[:brand_counts][bkey] || 0) }
        %table{style: "width: 100%; border-collapse: collapse; font-size: 0.875rem;"}
          %thead
            %tr
              %th{style: "text-align: left; padding: 0.4rem 0.75rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600;"} Brand
              %th{style: "text-align: right; padding: 0.4rem 0.75rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600;"} % Ranked #1
          %tbody
            - sorted.each do |bkey, bname|
              - ranked1 = @latest_stats[:brand_counts][bkey] || 0
              - total = @latest_stats[:total]
              - pct = total > 0 ? (ranked1.to_f / total * 100).round(1) : 0
              %tr
                %td{style: "padding: 0.4rem 0.75rem; border-bottom: 1px solid #f1f5f9;"}= bname
                %td{style: "text-align: right; padding: 0.4rem 0.75rem; border-bottom: 1px solid #f1f5f9; font-weight: 600; color: #16a34a;"}= "#{pct}%"
      - else
        %p.text-muted No data available yet.

  / ── Not Mentioned ───────────────────────────────────────────
  .panel{style: "margin-bottom: 1.5rem;"}
    .card-header{style: "display: flex; align-items: center; justify-content: space-between;"}
      %div
        %h3 🔍 Not Mentioned
        %p.text-muted{style: "font-size: 0.8rem; margin: 0;"} AI conversations where a brand was completely absent
      .card-header-actions
        - if brand_key.present?
          = link_to "View Results →", not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal, brand_key: brand_key), class: "btn btn-primary btn-sm"
          = link_to "📤 Share", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal, brand_key: brand_key), class: "btn btn-share btn-sm"
        - else
          = link_to "View Results →", not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal), class: "btn btn-primary btn-sm"
          = link_to "📤 Share", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: latest_ordinal), class: "btn btn-share btn-sm"
    .card-body
      - if @latest_stats && @latest_stats[:total] > 0
        %p.text-muted{style: "font-size: 0.8rem; margin-bottom: 1rem;"} Latest run (Run #{latest_ordinal}) · #{@latest_stats[:total]} total answers
        - sorted = @latest_stats[:brand_names].sort_by { |bkey, _| -(@latest_stats[:not_mentioned_counts][bkey] || 0) }
        %table{style: "width: 100%; border-collapse: collapse; font-size: 0.875rem;"}
          %thead
            %tr
              %th{style: "text-align: left; padding: 0.4rem 0.75rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600;"} Brand
              %th{style: "text-align: right; padding: 0.4rem 0.75rem; border-bottom: 1px solid #e2e8f0; color: #6b7280; font-weight: 600;"} Not Mentioned
          %tbody
            - sorted.each do |bkey, bname|
              - not_mentioned = @latest_stats[:not_mentioned_counts][bkey] || 0
              - total = @latest_stats[:total]
              - pct = total > 0 ? (not_mentioned.to_f / total * 100).round(1) : 0
              %tr
                %td{style: "padding: 0.4rem 0.75rem; border-bottom: 1px solid #f1f5f9;"}= bname
                %td{style: "text-align: right; padding: 0.4rem 0.75rem; border-bottom: 1px solid #f1f5f9; font-weight: 600; color: #dc2626;"}= "#{not_mentioned} (#{pct}%)"
      - else
        %p.text-muted No data available yet.

  / ── All Runs ────────────────────────────────────────────────
  - if @runs && @runs.any?
    .panel
      .card-header
        %h3 All Runs
        %span.text-muted{style: "font-size: 0.8rem;"} #{@runs.count} total
      %table.table{style: "border-radius: 0; box-shadow: none;"}
        %thead
          %tr
            %th Run
            %th Date
            %th{style: "text-align: right;"} Share
        %tbody
          - @runs.each do |run|
            - ordinal = run['ordinal'] || run[:ordinal]
            - created_at = run['createdAt'] || run['created_at'] || run[:created_at]
            %tr
              %td
                %strong Run #{ordinal}
              %td.text-muted
                - if created_at
                  = Time.parse(created_at).strftime("%b %d, %Y") rescue created_at
                - else
                  —
              %td{style: "text-align: right;"}
                - if brand_key.present?
                  = link_to "📤 Not Mentioned", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: ordinal, brand_key: brand_key), class: "btn btn-share btn-sm"
                - else
                  = link_to "📤 Not Mentioned", customer_not_mentioned_report_run_path(report_id: report_id, ordinal: ordinal), class: "btn btn-share btn-sm"
