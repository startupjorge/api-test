!!!
%html
  %head
    %title= content_for(:title) || "Gumshoe"
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}
    %meta{name: "apple-mobile-web-app-capable", content: "yes"}
    %meta{name: "application-name", content: "Gumshoe"}
    %meta{name: "mobile-web-app-capable", content: "yes"}
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{rel: "icon", href: "/icon.png", type: "image/png"}
    %link{rel: "icon", href: "/icon.svg", type: "image/svg+xml"}
    %link{rel: "apple-touch-icon", href: "/icon.png"}
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
  %body
    %nav.navigation
      .container
        = link_to root_path, class: "logo" do
          = image_tag "gumshoe-logo-white.svg", alt: "Gumshoe", style: "height: 28px; width: auto;"
        .nav-right
          .nav-internal
            = link_to "Reports", reports_path, class: "nav-link"
            = link_to "Explore", explore_internal_path, class: "nav-link"
            = link_to "⚙ Settings", settings_path, class: "nav-link"
          .nav-divider
          .nav-customer
            %span.nav-customer-label Share
            = link_to "How To Guide", how_to_path, class: "nav-link nav-link-customer"
    .container
      - if notice
        .alert.alert-success= notice
      - if alert
        .alert.alert-danger= alert
      = yield

  :javascript
    function copyPageUrl(btn) {
      navigator.clipboard.writeText(window.location.href).then(() => {
        btn.textContent = '✓ Copied!';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = 'Copy Link'; btn.classList.remove('copied'); }, 2000);
      });
    }
