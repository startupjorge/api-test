!!!
%html
  %head
    %title= content_for(:title) || "Gumshoe"
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}
    %meta{name: "apple-mobile-web-app-capable", content: "yes"}
    %meta{name: "application-name", content: "Gumshoe"}
    %meta{name: "mobile-web-app-capable", content: "yes"}
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{rel: "icon", href: "/icon.png", type: "image/png"}
    %link{rel: "icon", href: "/icon.svg", type: "image/svg+xml"}
    %link{rel: "apple-touch-icon", href: "/icon.png"}
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
  %body
    %nav.navigation
      .container
        = link_to root_path, class: "logo" do
          = image_tag "gumshoe-logo-white.svg", alt: "Gumshoe", style: "height: 28px; width: auto;"
          %span.logo-app-name API Test Center
        .nav-right
          - if logged_in?
            .nav-internal
              = link_to "Reports", reports_path, class: "nav-link"
              %span.nav-sep |
              = link_to "API Key", settings_path, class: "nav-link"
              - if employee?
                %span.nav-sep |
                = link_to "Invite", invite_index_path, class: "nav-link"
          - if logged_in?
            .nav-divider
            = link_to "API Docs", "https://app.gumshoe.ai/openapi", class: "nav-link nav-link-docs", target: "_blank"
            .nav-divider
            - if current_user_email.present?
              %span.nav-employee= current_user_email.split('@').first.capitalize
            = link_to "Sign out", logout_path, class: "nav-link nav-link-signout"
    - if logged_in?
      .flow-bar
        .container
          - steps = employee? ? [[settings_path, "1 · API Key"], [reports_path, "2 · Select a Report & Query"], [invite_index_path, "3 · Share"]] : [[settings_path, "1 · API Key"], [reports_path, "2 · Select a Report & Query"]]
          - steps.each_with_index do |(path, label), i|
            - active = request.path.start_with?(path) || (path == reports_path && request.path == '/')
            = link_to label, path, class: "flow-step #{active ? 'flow-step-active' : ''}"
            - if i < steps.length - 1
              %span.flow-step-arrow →
    .container
      - if notice
        .alert.alert-success= notice
      - if alert
        .alert.alert-danger= alert
      = yield

  :javascript
    function copyPageUrl(btn) {
      navigator.clipboard.writeText(window.location.href).then(() => {
        btn.textContent = '✓ Copied!';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = 'Copy Link'; btn.classList.remove('copied'); }, 2000);
      });
    }
