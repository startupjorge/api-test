- content_for :title, "Sign In · Gumshoe"
.login-page
  .login-card
    .login-logo
      = image_tag "gumshoe-logo-white.svg", alt: "Gumshoe", style: "height: 36px; width: auto;"
    %h1.login-title Sign in to Gumshoe API Test Center
    %p.login-subtitle Enter your email to continue

    - if flash[:alert]
      .alert.alert-danger= flash[:alert]

    = form_with url: login_path, method: :post, local: true do |f|
      .login-field
        = f.label :email, "Email address"
        = f.email_field :email, placeholder: "you@example.com", class: "login-input", autofocus: true, value: params[:email]
      = f.submit "Continue →", class: "btn btn-primary login-submit"

    %p.login-note
      Gumshoe employees sign in with their @gumshoe.ai address.
      %br
      Customers — ask your Gumshoe contact to add your email.
