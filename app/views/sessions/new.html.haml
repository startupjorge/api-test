- content_for :title, "Sign In · Gumshoe"
.login-page
  .login-card
    .login-logo
      = image_tag "gumshoe-logo-white.svg", alt: "Gumshoe", style: "height: 36px; width: auto;"
    %h1.login-title Gumshoe API Test Center
    %p.login-subtitle Enter your Gumshoe API key to get started

    - if flash[:alert]
      .alert.alert-danger= flash[:alert]

    = form_with url: login_path, method: :post, local: true do |f|
      .login-field
        = f.label :api_key, "API Key"
        = f.password_field :api_key, placeholder: "gsorg_live_…", class: "login-input", autofocus: true, autocomplete: "off"
      = f.submit "Continue →", class: "btn btn-primary login-submit"
