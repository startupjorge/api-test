.breadcrumb
  = link_to "Reports", reports_path
  %span.breadcrumb-sep /
  = link_to "Report #{@report_id}", report_path(@report_id)
  %span.breadcrumb-sep /
  %span Not Mentioned — Run #{@ordinal}

.page-header{style: "display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 1rem;"}
  %div
    %h1 Not Mentioned — Run #{@ordinal}
    %p.text-muted Report ##{@report_id} · Conversations where a brand was completely absent from AI answers
  .btn-group
    = link_to "📤 Share Externally", customer_not_mentioned_report_run_path(report_id: @report_id, ordinal: @ordinal, brand_key: @brand_key), class: "btn btn-share btn-sm"

- if @error
  .alert.alert-danger
    %strong Error:
    = @error

.panel{style: "margin-bottom: 1.5rem;"}
  .card-header
    %h3 Filter by Brand
  .card-body
    = form_with url: not_mentioned_report_run_path(report_id: @report_id, ordinal: @ordinal), method: :get, local: true do |f|
      .form-row
        .form-group
          = f.label :brand_key, "Brand Key"
          = f.text_field :brand_key, value: @brand_key, placeholder: "e.g. shipiumcom", style: "min-width: 220px;"
        = f.submit "Filter", class: "btn btn-primary"
      %p.text-muted{style: "margin-top: 0.5rem; font-size: 0.8rem;"} The brand key is the internal identifier (e.g. shipiumcom, not "Shipium")

- if @brand_key.present? && !@error
  .stats-row
    .stat-card
      .stat-number{style: "color: #1a2332;"}= @total_answers
      .stat-label Total Answers
    .stat-card
      .stat-number{style: "color: #dc2626;"}= @not_mentioned.size
      .stat-label Not Mentioned
    .stat-card
      .stat-number{style: "color: #059669;"}= @total_answers - @not_mentioned.size
      .stat-label Was Mentioned

  %p{style: "margin-bottom: 1rem; font-size: 0.95rem; color: #374151;"}
    %strong= "#{@not_mentioned.size} conversations"
    where
    %strong= "\"#{@brand_key}\""
    was not mentioned, out of #{@total_answers} total answers.

  - if @not_mentioned.any?
    - @not_mentioned.each do |answer|
      .answer-card
        .meta
          %span
            %strong Persona:
            = answer[:persona_name]
          %span
            %strong Model:
            = answer[:model].presence || "—"
        .question= answer[:question_text]
        .answer-text= answer[:answer_text]
        - if answer[:citations].any?
          %hr.divider
          %p{style: "font-size: 0.78rem; color: #9ca3af;"}
            %strong Citations:
            = answer[:citations].map { |c| c["url"] || c[:url] || c.to_s }.join(" · ")
  - else
    .card
      .card-body
        %p.text-muted "#{@brand_key}" appeared in every conversation in this run.
