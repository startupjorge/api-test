- if @query.present?
  .share-bar
    .share-bar-text
      🔗 This page is ready to share
      %span Copy the URL from your browser's address bar to share these exact results
    %button.btn.btn-copy{onclick: "copyPageUrl(this)"} Copy Link

.explore-page
  .explore-hero
    %h1.explore-title Ask a question about your brand data
    %p.explore-subtitle Enter a question below and hit Run — we'll pull the latest data from the Gumshoe API and show you the results.

  = form_with url: root_path, method: :get, local: true do |f|
    .explore-input-row
      = f.text_field :query, value: @query,
          placeholder: "e.g. Show rank trends for report 22110",
          class: "explore-input",
          autocomplete: "off"
      = f.submit "Run →", class: "btn btn-primary explore-submit"

  .explore-chips
    %span.chips-label Try:
    %button.chip{type: "button", onclick: "setExploreQuery('Show rank trends for report 22110')"} 📈 Rank trends
    %button.chip{type: "button", onclick: "setExploreQuery('Not mentioned for brand shipiumcom in report 22110 run 1')"} 🔍 Not mentioned

- if @query.present?
  .explore-results
    - if @result_error
      .alert.alert-danger= @result_error
    - elsif @result_type == :trends
      = render "trends_result"
    - elsif @result_type == :not_mentioned
      = render "not_mentioned_result"
    - elsif @result_type == :reports
      = render "reports_result"
    - elsif @intent && @intent[:action] == :unknown
      .alert{style: "background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; border-radius: 8px; padding: 1rem 1.25rem;"}
        Couldn't figure out what to do with that. Try something like:
        %ul{style: "margin: 0.5rem 0 0 1.25rem;"}
          %li "Show rank trends for report 22110"
          %li "Not mentioned for brand shipiumcom in report 22110 run 1"

    - if @result_type && !@result_error
      .explore-share-row
        %span.share-hint Want to share these results?
        %button.btn.btn-copy{onclick: "copyPageUrl(this)"} Copy Link

:javascript
  function setExploreQuery(text) {
    document.querySelector('.explore-input').value = text;
    document.querySelector('.explore-input').focus();
  }
