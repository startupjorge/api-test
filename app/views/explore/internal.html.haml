.admin-flow-bar
  .flow-step.flow-step-done= link_to "1 · API Key", settings_path
  .flow-step-arrow →
  .flow-step.flow-step-active 2 · Test
  .flow-step-arrow →
  .flow-step= link_to "3 · Reports", reports_path
  .flow-step-arrow →
  .flow-step= link_to "4 · Share", invite_index_path

- if current_api_key.blank?
  .alert{style: "background: #fffbeb; border: 1px solid #fcd34d; color: #92400e; border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1.5rem;"}
    %strong No API key set.
    = link_to "Add your Gumshoe API key in Settings →", settings_path, style: "margin-left: 0.5rem; font-weight: 600;"

.test-center
  .test-center-header
    %h1 Gumshoe API Test Center
    %p.text-muted Pick a report and a query — see the live request, raw JSON response, and processed result.

  = form_with url: root_path, method: :get, local: true do |f|

    .test-step
      .test-step-label Step 1 — Select a report
      - if @reports.any?
        = f.select :report_id,
            @reports.map { |r| [r["title"] || r[:title] || r["id"] || r[:id], r["id"] || r[:id]] },
            { include_blank: "— choose a report —", selected: @report_id },
            class: "form-select"
      - elsif current_api_key.blank?
        %p.text-muted{style: "font-size: 0.875rem;"} Add an API key above to load your reports.
      - else
        %p.text-muted{style: "font-size: 0.875rem;"} No reports found for this API key.

    .test-step
      .test-step-label Step 2 — Choose a query
      .query-cards
        .query-card{id: "card-trends", onclick: "document.getElementById('qt_trends').click()"}
          = f.radio_button :query_type, "trends", id: "qt_trends", checked: @query_type != "not_mentioned"
          %label.query-card-label{for: "qt_trends"}
            .query-card-icon 📈
            .query-card-content
              %strong % Results Ranked #1
              %p How often each brand appears as the #1 AI answer across all runs — tracks visibility momentum over time
              %p.query-card-endpoint
                %code GET /reports/:id/runs/:ordinal/raw

        .query-card{id: "card-not_mentioned", onclick: "document.getElementById('qt_not_mentioned').click()"}
          = f.radio_button :query_type, "not_mentioned", id: "qt_not_mentioned"
          %label.query-card-label{for: "qt_not_mentioned"}
            .query-card-icon 🔍
            .query-card-content
              %strong Not Mentioned
              %p Conversations where a brand was completely absent from AI answers — surfaces competitive blind spots
              %p.query-card-endpoint
                %code GET /reports/:id/runs/:ordinal/raw

    #brand-key-group{style: "display: none;"}
      .test-step
        .test-step-label Brand key
        %p.text-muted{style: "font-size: 0.82rem; margin-bottom: 0.5rem;"}
          The brand identifier to filter on — e.g.
          %code shipiumcom
        = f.text_field :brand_key, value: @brand_key, placeholder: "e.g. shipiumcom", class: "form-control", style: "max-width: 320px;"

    .test-step
      = f.submit "Run →", class: "btn btn-primary btn-lg"


- recent = (session[:query_history] || [])
- if recent.any?
  .explore-recent{style: "margin-top: 2rem;"}
    %p.explore-recent-label Recent Runs:
    %ul.explore-recent-list
      - recent.first(5).each do |h|
        - friendly = h["action"] == "trends" ? "% Results Ranked #1" : "Not Mentioned"
        - detail_path = h["action"] == "trends" ? api_query_rank_trends_path : api_query_not_mentioned_path
        %li
          = link_to friendly, detail_path, class: "recent-query-link"
          - if h["report_id"]
            %span.recent-query-meta= "report #{h["report_id"]}#{" · #{h["brand_key"]}" if h["brand_key"].present?}"

:javascript
  (function() {
    const radios = document.querySelectorAll('input[name="query_type"]');
    const brandGroup = document.getElementById('brand-key-group');

    function updateUI() {
      const selected = document.querySelector('input[name="query_type"]:checked');
      document.querySelectorAll('.query-card').forEach(c => c.classList.remove('query-card-selected'));
      if (selected) {
        document.getElementById('card-' + selected.value)?.classList.add('query-card-selected');
        brandGroup.style.display = selected.value === 'not_mentioned' ? '' : 'none';
      }
    }

    radios.forEach(r => r.addEventListener('change', updateUI));
    updateUI();
  })();

